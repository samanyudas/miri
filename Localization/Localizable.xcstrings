        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aktywne staje się okno poniżej w tej samej kolumnie. Żadne okno się nie przesuwa."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O foco vai para a janela abaixo na mesma coluna. Nenhuma janela se move."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O foco passa para a janela abaixo na mesma coluna. Nenhuma janela se move."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Фокус переходит на окно ниже в той же колонке. Окна не перемещаются."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Fokus flyttas till fönstret nedanför i samma kolumn. Inget fönster flyttas."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "โฟกัสย้ายไปยังหน้าต่างด้านล่างในคอลัมน์เดียวกัน ไม่มีหน้าต่างใดย้าย"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Odak aynı sütunda alttaki pencereye geçer. Hiçbir pencere taşınmaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Фокус переходить на вікно нижче в тій самій колонці. Жодне вікно не рухається."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tiêu điểm chuyển xuống cửa sổ phía dưới trong cùng cột. Không cửa sổ nào di chuyển."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "焦点移到同一列中下方的窗口。窗口不会移动。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "焦點移至同一欄中下方的視窗。視窗不會移動。"
          }
        }
      }
    },
    "Focus shortcuts, display focus, and workspace switches move it to the window's centre. Clicks and Cmd-Tab leave it in place.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "تنقل اختصارات التركيز وتركيز شاشة العرض والتبديل بين المساحات المؤشرَ إلى منتصف النافذة. أما النقرات وCmd-Tab فتُبقيه في مكانه."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Fokus-Kurzbefehle, Display-Fokus und Space-Wechsel bewegen ihn in die Mitte des Fensters. Klicks und Cmd-Tab lassen ihn, wo er ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Los atajos de activación, la activación de una pantalla y los cambios de Space lo llevan al centro de la ventana. Los clics y Cmd-Tab lo dejan donde está."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Les raccourcis d’activation, l’activation d’un moniteur et les changements de Space le placent au centre de la fenêtre. Les clics et Cmd-Tab le laissent en place."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "फ़ोकस शॉर्टकट, डिस्प्ले फ़ोकस और Space बदलने पर पॉइंटर विंडो के बीच में चला जाता है। क्लिक और Cmd-Tab से वह अपनी जगह पर रहता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pintasan fokus, fokus layar, dan peralihan Space memindahkan penunjuk ke tengah jendela. Klik dan Cmd-Tab membiarkannya di tempat."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Le scorciatoie di attivazione, l’attivazione di uno schermo e i cambi di spazio lo portano al centro della finestra. I clic e Cmd-Tab lo lasciano dov’è."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "フォーカスのショートカット、ディスプレイへのフォーカス、操作スペースの切り替えでは、ポインタがウインドウの中央に移動します。クリックやCmd-Tabでは移動しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "초점 단축키, 디스플레이 초점 이동, Space 전환 시 포인터가 윈도우 중앙으로 이동합니다. 클릭하거나 Cmd-Tab을 사용하면 포인터가 그대로 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Focustoetscombinaties, beeldschermfocus en wisselen van space verplaatsen hem naar het midden van het venster. Klikken en Cmd-Tab laten hem staan."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Skróty zmiany aktywnego okna, przejście na inny wyświetlacz i zmiana przestrzeni przenoszą wskaźnik na środek okna. Kliknięcia i Cmd-Tab zostawiają go w miejscu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Atalhos de foco, foco de tela e trocas de Space levam o cursor ao centro da janela. Cliques e Cmd-Tab o deixam no lugar."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Os atalhos de foco, o foco de monitor e as mudanças de Space levam o cursor ao centro da janela. Os cliques e Cmd-Tab deixam-no no lugar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Сочетания клавиш фокуса, фокус на дисплей и переключение пространств перемещают указатель в центр окна. Щелчки и Cmd-Tab оставляют его на месте."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Fokuskortkommandon, bildskärmsfokus och byten av Space flyttar den till fönstrets mitt. Klick och Cmd-Tab lämnar den där den är."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ปุ่มลัดโฟกัส การโฟกัสจอภาพ และการสลับ Space จะย้ายตัวชี้ไปที่กึ่งกลางหน้าต่าง การคลิกและ Cmd-Tab จะไม่ย้ายตัวชี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Odak kestirmeleri, ekran odağı ve Spaces alanı geçişleri imleci pencerenin ortasına taşır. Tıklamalar ve Cmd-Tab imleci yerinde bırakır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Скорочення фокуса, фокус на дисплей і перемикання просторів переносять вказівник у центр вікна. Клацання та Cmd-Tab залишають його на місці."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Phím tắt tiêu điểm, chuyển tiêu điểm màn hình và chuyển Space sẽ đưa con trỏ tới giữa cửa sổ. Bấm chuột và Cmd-Tab giữ nguyên vị trí con trỏ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "焦点快捷键、聚焦显示器和切换空间会将指针移到窗口中央。点按和 Cmd-Tab 不会移动指针。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "焦點快速鍵、聚焦顯示器和切換空間會將指標移到視窗中央。按一下和Cmd-Tab不會移動指標。"
          }
        }
      }
    },
