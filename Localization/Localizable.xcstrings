    "The focused window joins the column on its left. The rest of its old column stays in place.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "تنضم النافذة المركّز عليها إلى العمود الذي على يسارها. يبقى باقي عمودها القديم في مكانه."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Das fokussierte Fenster wechselt in die Spalte links von ihm. Der Rest seiner alten Spalte bleibt, wo er ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La ventana activa se une a la columna de su izquierda. El resto de su antigua columna se queda donde está."
