        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "macOS में “गति घटाएँ” चालू होने पर मूवमेंट हमेशा तुरंत होता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pergerakan selalu instan saat Kurangi gerakan macOS menyala."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Il movimento è sempre immediato quando “Riduci movimento” di macOS è attivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "macOSの「視差効果を減らす」がオンのときは、移動は常に瞬時に行われます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "macOS의 동작 줄이기가 켜져 있으면 항상 즉시 이동합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Beweging is altijd direct als ‘Verminder beweging’ in macOS aan staat."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ruch jest zawsze natychmiastowy, gdy w macOS włączona jest opcja „Redukuj ruch”."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O movimento é sempre instantâneo quando Reduzir Movimento do macOS está ativado."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O movimento é sempre instantâneo quando Reduzir movimento do macOS está ativado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Если в macOS включено «Уменьшить движение», окна всегда перемещаются мгновенно."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Rörelser sker alltid direkt när Minska rörelse är på i macOS."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "การเคลื่อนไหวจะเกิดขึ้นทันทีเสมอเมื่อเปิดลดการเคลื่อนไหวของ macOS"
          }
        },
        "tr": {
