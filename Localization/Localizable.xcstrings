        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "फ़ोकस की गई विंडो अपने कॉलम में ऊपर वाली विंडो से जगह बदलती है। फ़ोकस उसी पर रहता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Jendela terfokus bertukar tempat dengan jendela di atasnya dalam kolomnya. Fokus tetap padanya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La finestra attiva scambia il posto con la finestra sopra di lei nella sua colonna. Resta attiva."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "フォーカスのあるウインドウが同じ列の上のウインドウと入れ替わります。フォーカスはそのウインドウのままです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "초점이 있는 윈도우가 같은 열의 위쪽 윈도우와 자리를 바꿉니다. 초점은 그 윈도우에 유지됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Het gefocuste venster ruilt van plaats met het venster erboven in de kolom. De focus blijft erop."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aktywne okno zamienia się miejscami z oknem powyżej w swojej kolumnie. Pozostaje aktywne."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A janela em foco troca de lugar com a janela acima dela na coluna. O foco continua nela."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A janela em foco troca de lugar com a janela acima dela na coluna. O foco mantém-se nela."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Окно в фокусе меняется местами с окном над ним в его колонке. Фокус остается на нем."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Det fokuserade fönstret byter plats med fönstret ovanför det i kolumnen. Fokus stannar på det."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "หน้าต่างที่โฟกัสอยู่สลับที่กับหน้าต่างด้านบนในคอลัมน์เดียวกัน โฟกัสยังอยู่ที่หน้าต่างนี้"
