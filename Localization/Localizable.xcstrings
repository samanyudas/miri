    "Open System Settings > Desktop & Dock > Mission Control and make sure Displays have separate Spaces is on.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "افتح إعدادات النظام > سطح المكتب وشريط الأيقونات > إدارة المهام وتأكد من تشغيل «توجد للشاشات مساحات منفصلة»."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Öffne „Systemeinstellungen > Schreibtisch & Dock > Mission Control“ und stelle sicher, dass „Monitore verwenden verschiedene Spaces“ aktiviert ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Abre Ajustes del Sistema > Escritorio y Dock > Mission Control y comprueba que “Pantallas con Spaces separados” esté activado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ouvrez Réglages Système > Bureau et Dock > Mission Control et vérifiez que « Les écrans disposent de Spaces distincts » est activé."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "सिस्टम सेटिंग > डेस्कटॉप और Dock > Mission Control खोलें और पक्का करें कि “अलग-अलग डिस्प्ले में अलग-अलग Spaces होने चाहिए” चालू है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Buka Pengaturan Sistem > Desktop & Dock > Mission Control dan pastikan “Tampilan memiliki Spaces terpisah” menyala."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Apri Impostazioni di Sistema > Scrivania e Dock > Mission Control e assicurati che “Gli schermi hanno spazi separati” sia attivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "「システム設定 > デスクトップとDock > Mission Control」を開き、「ディスプレイごとに個別の操作スペース」がオンになっていることを確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "시스템 설정 > 데스크탑 및 Dock > Mission Control을 열고 각각의 Spaces가 있는 디스플레이가 켜져 있는지 확인하십시오."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Open Systeeminstellingen > Bureaublad en Dock > Mission Control en zorg dat ‘Beeldschermen hebben afzonderlijke spaces’ is ingeschakeld."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Otwórz Ustawienia systemowe > Biurko i Dock > Mission Control i upewnij się, że opcja „Osobne przestrzenie dla wyświetlaczy” jest włączona."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Abra Ajustes do Sistema > Mesa e Dock > Mission Control e confira se “As telas têm Spaces separados” está ativado."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Abra Definições do Sistema > Secretária e Dock > Mission Control e confirme que “Ecrãs têm Spaces diferentes” está ativado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Откройте «Системные настройки > Рабочий стол и Dock > Mission Control» и убедитесь, что параметр «Дисплеи с разными рабочими пространствами Spaces» включен."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Öppna System­inställningar > Skrivbord och Dock > Mission Control och se till att Bildskärmar har egna Spaces är på."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "เปิดการตั้งค่าระบบ > เดสก์ท็อปและ Dock > Mission Control และตรวจสอบให้แน่ใจว่าเปิด Space ของจอภาพแยกต่างหากอยู่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sistem Ayarları > Masaüstü ve Dock > Mission Control’ü açın ve Ekranların ayrı Spaces alanları olsun ayarının açık olduğundan emin olun."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Відкрийте «Системні параметри > Робочий стіл і Dock > Mission Control» і переконайтеся, що параметр «Окремі Spaces на дисплеях» увімкнено."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mở Cài đặt hệ thống > Màn hình nền & Dock > Mission Control và đảm bảo Màn hình có các Spaces riêng biệt đang bật."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "打开“系统设置 > 桌面与程序坞 > 调度中心”，确保“显示器具有单独空间”已打开。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "打開「系統設定 > 桌面與Dock > 指揮中心」，確認「顯示器有單獨空間」已開啟。"
          }
        }
      }
    },
    "Open System Settings > Desktop & Dock > Windows and make sure %@ is off.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "افتح إعدادات النظام > سطح المكتب وشريط الأيقونات > النوافذ وتأكد من إيقاف %@."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Öffne „Systemeinstellungen > Schreibtisch & Dock > Fenster“ und stelle sicher, dass %@ deaktiviert ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Abre Ajustes del Sistema > Escritorio y Dock > Ventanas y comprueba que estas opciones estén desactivadas: %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ouvrez Réglages Système > Bureau et Dock > Fenêtres et vérifiez que ces options sont désactivées : %@."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "सिस्टम सेटिंग > डेस्कटॉप और Dock > विंडो खोलें और पक्का करें कि %@ बंद है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Buka Pengaturan Sistem > Desktop & Dock > Jendela dan pastikan %@ mati."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Apri Impostazioni di Sistema > Scrivania e Dock > Finestre e assicurati che queste opzioni siano disattivate: %@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "「システム設定 > デスクトップとDock > ウインドウ」を開き、%@がオフになっていることを確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "시스템 설정 > 데스크탑 및 Dock > 윈도우를 열고 %@이(가) 꺼져 있는지 확인하십시오."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Open Systeeminstellingen > Bureaublad en Dock > Vensters en zorg dat %@ is uitgeschakeld."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Otwórz Ustawienia systemowe > Biurko i Dock > Okna i upewnij się, że te opcje są wyłączone: %@."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Abra Ajustes do Sistema > Mesa e Dock > Janelas e confira se %@ está desativado."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Abra Definições do Sistema > Secretária e Dock > Janelas e confirme que %@ está desativado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Откройте «Системные настройки > Рабочий стол и Dock > Окна» и убедитесь, что выключено: %@."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Öppna System­inställningar > Skrivbord och Dock > Fönster och se till att %@ är av."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "เปิดการตั้งค่าระบบ > เดสก์ท็อปและ Dock > หน้าต่าง และตรวจสอบให้แน่ใจว่าปิด %@ อยู่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sistem Ayarları > Masaüstü ve Dock > Pencereler’i açın ve şu ayarların kapalı olduğundan emin olun: %@."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Відкрийте «Системні параметри > Робочий стіл і Dock > Вікна» і переконайтеся, що вимкнено: %@."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mở Cài đặt hệ thống > Màn hình nền & Dock > Cửa sổ và đảm bảo %@ đang tắt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "打开“系统设置 > 桌面与程序坞 > 窗口”，确保 %@ 已关闭。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "打開「系統設定 > 桌面與Dock > 視窗」，確認%@已關閉。"
          }
        }
      }
    },
