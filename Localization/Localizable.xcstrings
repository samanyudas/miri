  "sourceLanguage": "en",
  "strings": {
    "": {},
    "\"%@\" has more than one dash. Write the modifiers joined by +, then one dash and the key.": {},
    "\"%@\" names the key \"%@\", which the engine does not know, so the shortcut does nothing. ": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "\"%1$@\" names the key \"%2$@\", which the engine does not know, so the shortcut does nothing. "
          }
        }
      }
    },
    "\"%@\" names the modifier \"%@\", which the engine does not know. ": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "\"%1$@\" names the modifier \"%2$@\", which the engine does not know. "
          }
        }
      }
    },
