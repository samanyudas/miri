    "%@ can move a window that Miri arranges, and the window's column can then change place in the strip. Quit %@ while Miri manages windows.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "يمكن لـ %1$@ نقل نافذة يرتبها Miri، وقد يتغير بعدها مكان عمود النافذة في الشريط. قم بإنهاء %2$@ أثناء إدارة Miri للنوافذ."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ kann ein Fenster bewegen, das Miri anordnet, und die Spalte des Fensters kann dann ihren Platz im Streifen ändern. Beende %2$@, während Miri Fenster verwaltet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ can move a window that Miri arranges, and the window's column can then change place in the strip. Quit %2$@ while Miri manages windows."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ puede mover una ventana que Miri organiza, y la columna de esa ventana puede cambiar de lugar en la tira. Sal de %2$@ mientras Miri gestiona las ventanas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ peut déplacer une fenêtre organisée par Miri, et la colonne de cette fenêtre peut alors changer de place dans la bande. Quittez %2$@ pendant que Miri gère les fenêtres."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ उस विंडो को मूव कर सकता है जिसे Miri व्यवस्थित करता है, और तब स्ट्रिप में उस विंडो का कॉलम अपनी जगह बदल सकता है। जब Miri विंडो प्रबंधित कर रहा हो, तब %2$@ को बंद करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ dapat memindahkan jendela yang diatur Miri, lalu kolom jendela tersebut dapat berpindah tempat di lajur. Tutup %2$@ selagi Miri mengelola jendela."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ può spostare una finestra disposta da Miri, e la colonna della finestra può quindi cambiare posizione nella striscia. Esci da %2$@ mentre Miri gestisce le finestre."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@はMiriが配置したウインドウを動かすことがあり、そのウインドウの列がストリップ内で位置を変える場合があります。Miriがウインドウを管理している間は%2$@を終了してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@은(는) Miri가 정렬하는 윈도우를 이동할 수 있으며, 그러면 해당 윈도우의 열이 스트립에서 위치를 바꿀 수 있습니다. Miri가 윈도우를 관리하는 동안에는 %2$@을(를) 종료하십시오."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ kan een venster verplaatsen dat Miri ordent, waarna de kolom van dat venster van plaats kan veranderen in de strook. Stop %2$@ terwijl Miri vensters beheert."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ może przesuwać okna, które układa Miri, a wtedy kolumna okna może zmienić miejsce na pasie. Zakończ %2$@, gdy Miri zarządza oknami."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ pode mover uma janela organizada pelo Miri, e a coluna dessa janela pode mudar de lugar na faixa. Encerre %2$@ enquanto o Miri gerencia as janelas."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ pode mover uma janela organizada pelo Miri, e a coluna dessa janela pode então mudar de lugar na faixa. Saia de %2$@ enquanto o Miri gere as janelas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ может перемещать окна, которые упорядочивает Miri, и тогда колонка окна может сменить место на ленте. Завершите %2$@, пока Miri управляет окнами."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ kan flytta ett fönster som Miri ordnar, och då kan fönstrets kolumn byta plats i remsan. Avsluta %2$@ medan Miri hanterar fönster."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ สามารถย้ายหน้าต่างที่ Miri จัดเรียงอยู่ และคอลัมน์ของหน้าต่างนั้นอาจเปลี่ยนตำแหน่งในแถว ให้ออกจาก %2$@ ขณะที่ Miri จัดการหน้าต่าง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@, Miri’nin düzenlediği bir pencereyi taşıyabilir ve bu pencerenin sütunu şeritte yer değiştirebilir. Miri pencereleri yönetirken şu uygulamadan çıkın: %2$@."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ може пересувати вікна, які впорядковує Miri, і тоді колонка вікна може змінити місце на стрічці. Завершіть %2$@, поки Miri керує вікнами."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ có thể di chuyển cửa sổ mà Miri sắp xếp, và cột của cửa sổ đó có thể đổi vị trí trong dải. Hãy thoát %2$@ khi Miri đang quản lý cửa sổ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@ 可能会移动 Miri 排列的窗口，导致该窗口所在的列在条带中改变位置。请在 Miri 管理窗口时退出 %2$@。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%1$@可能會移動Miri排列的視窗，使該視窗所在的欄在條帶中改變位置。請在Miri管理視窗時結束%2$@。"
          }
        }
      }
    },
