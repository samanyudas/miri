    "Miri could not read the macOS four-finger swipe settings. Use Test Gesture on the Gestures page to check the swipe.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "تعذر على Miri قراءة إعدادات التمرير السريع بأربعة أصابع في macOS. استخدم «اختبار الإيماءة» في صفحة الإيماءات لفحص التمرير السريع."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Miri konnte die macOS-Einstellungen für das Streichen mit vier Fingern nicht lesen. Prüfe das Streichen mit „Geste testen“ auf der Seite „Gesten“."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Miri no ha podido leer los ajustes de macOS del deslizamiento con cuatro dedos. Usa “Probar gesto” en la página Gestos para comprobar el deslizamiento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Miri n’a pas pu lire les réglages macOS du balayage à quatre doigts. Utilisez « Tester le geste » dans la page Gestes pour vérifier le balayage."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Miri, macOS की चार उँगलियों वाली स्वाइप सेटिंग नहीं पढ़ सका। स्वाइप जाँचने के लिए जेस्चर पेज पर “जेस्चर टेस्ट करें” का उपयोग करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Miri tidak dapat membaca pengaturan gesek empat jari macOS. Gunakan Uji Gerakan di halaman Gerakan untuk memeriksa gesekan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Miri non è riuscito a leggere le impostazioni di macOS per lo scorrimento a quattro dita. Usa “Prova gesto” nella pagina Gesti per controllare lo scorrimento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "MiriはmacOSの4本指スワイプの設定を読み取れませんでした。「ジェスチャ」ページの「ジェスチャをテスト」でスワイプを確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Miri가 macOS의 네 손가락 쓸어넘기기 설정을 읽을 수 없습니다. 제스처 페이지에서 제스처 테스트를 사용하여 쓸어넘기기를 확인하십시오."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Miri kon de macOS-instellingen voor vegen met vier vingers niet lezen. Gebruik ‘Test gebaar’ op de pagina Gebaren om het vegen te controleren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Miri nie mogło odczytać ustawień przesunięcia czterema palcami w macOS. Sprawdź przesunięcie przyciskiem „Testuj gest” na stronie „Gesty”."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O Miri não conseguiu ler os ajustes do macOS para deslizar com quatro dedos. Use Testar Gesto na página Gestos para verificar o gesto."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O Miri não conseguiu ler as definições do macOS para deslizar com quatro dedos. Use Testar gesto na página Gestos para verificar o gesto."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Miri не удалось прочитать настройки смахивания четырьмя пальцами в macOS. Проверьте смахивание кнопкой «Проверить жест» на странице «Жесты»."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Miri kunde inte läsa inställningarna i macOS för svep med fyra fingrar. Använd Testa gest på sidan Gester för att kontrollera svepet."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Miri ไม่สามารถอ่านการตั้งค่าการปัดด้วยสี่นิ้วของ macOS ใช้ทดสอบคำสั่งนิ้วในหน้าคำสั่งนิ้วเพื่อตรวจสอบการปัด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Miri, macOS’in dört parmakla kaydırma ayarlarını okuyamadı. Kaydırmayı denetlemek için Hareketler sayfasında Hareketi Test Et’i kullanın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Miri не вдалося прочитати параметри змахування чотирма пальцями в macOS. Перевірте змахування кнопкою «Перевірити жест» на сторінці «Жести»."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Miri không thể đọc cài đặt vuốt bốn ngón của macOS. Hãy dùng Kiểm tra cử chỉ trên trang Cử chỉ để kiểm tra thao tác vuốt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Miri 无法读取 macOS 的四指轻扫设置。请在“手势”页面使用“测试手势”来检查轻扫。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Miri無法讀取macOS的四指滑動設定。請在「手勢」頁面使用「測試手勢」來檢查滑動。"
          }
        }
      }
    },
