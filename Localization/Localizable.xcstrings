        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Колонка в фокусе получает следующую заданную ширину относительно своего центра. Соседние колонки сдвигаются и сохраняют ширину."
          }
        },
        "sv": {
          "stringUnit": {
