{
  "sourceLanguage": "en",
  "strings": {
    "": {
      "shouldTranslate": false
    },
    "\"%@\" has more than one dash. Write the modifiers joined by +, then one dash and the key.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "«%@» يحتوي على أكثر من شرطة. اكتب مفاتيح التعديل موصولة بعلامة +، ثم شرطة واحدة ثم المفتاح."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "„%@“ hat mehr als einen Bindestrich. Schreibe die Sondertasten mit + verbunden, dann einen Bindestrich und die Taste."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "“%@” tiene más de un guion. Escribe los modificadores unidos con +, luego un solo guion y la tecla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "« %@ » contient plus d’un tiret. Écrivez les modificateurs joints par +, puis un seul tiret et la touche."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "“%@” में एक से ज़्यादा डैश है। मॉडिफ़ायर को + से जोड़कर लिखें, फिर एक डैश और फिर की।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "\"%@\" memiliki lebih dari satu tanda hubung. Tulis pengubah yang digabung dengan +, lalu satu tanda hubung dan tombolnya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "“%@” contiene più di un trattino. Scrivi i modificatori uniti da +, poi un solo trattino e il tasto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "「%@」にダッシュが複数あります。修飾キーを + でつなぎ、続けてダッシュを1つとキーを書いてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "\"%@\"에 대시가 두 개 이상 있습니다. 보조 키를 +로 연결한 다음 대시 하나와 키를 작성하십시오."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "‘%@’ bevat meer dan één streepje. Schrijf de speciale toetsen verbonden met +, dan één streepje en de toets."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "„%@” zawiera więcej niż jeden myślnik. Wpisz modyfikatory połączone znakiem +, a potem jeden myślnik i klawisz."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "\"%@\" tem mais de um hífen. Escreva os modificadores unidos por +, depois um hífen e a tecla."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "needs_review",
            "value": "\"%@\" tem mais de um hífen. Escreva os modificadores unidos por +, depois um hífen e a tecla."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "«%@» содержит больше одного дефиса. Запишите модификаторы через +, затем один дефис и клавишу."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "”%@” har mer än ett bindestreck. Skriv specialtangenterna förenade med +, sedan ett bindestreck och tangenten."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "\"%@\" มีขีดมากกว่าหนึ่งขีด ให้เขียนปุ่มปรับแต่งที่เชื่อมด้วย + แล้วตามด้วยขีดหนึ่งขีดและปุ่ม"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "“%@” birden fazla tire içeriyor. Değiştirici tuşları + ile birleştirerek yazın, ardından bir tire ve tuşu ekleyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "«%@» містить більше одного дефіса. Запишіть модифікатори через +, потім один дефіс і клавішу."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "\"%@\" có nhiều hơn một dấu gạch ngang. Hãy viết các phím bổ trợ nối bằng +, sau đó là một dấu gạch ngang và phím."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "“%@”包含多个短横线。请用 + 连接修饰键，然后写一个短横线和按键。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "「%@」包含多個連字號。請以 + 連接變更鍵，然後寫一個連字號和按鍵。"
          }
        }
      }
    },
    "\"%@\" names the key \"%@\", which the engine does not know, so the shortcut does nothing. ": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "«%1$@» يسمي المفتاح «%2$@» الذي لا يعرفه المحرك، لذا لا يفعل الاختصار شيئًا. "
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "„%1$@“ nennt die Taste „%2$@“, die die Engine nicht kennt, daher bewirkt der Kurzbefehl nichts. "
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "\"%1$@\" names the key \"%2$@\", which the engine does not know, so the shortcut does nothing. "
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "“%1$@” indica la tecla “%2$@”, que el motor no conoce, así que el atajo no hace nada. "
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "« %1$@ » désigne la touche « %2$@ », inconnue du moteur : le raccourci ne fait donc rien. "
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "“%1$@” में की “%2$@” का नाम है, जिसे इंजन नहीं जानता, इसलिए शॉर्टकट कुछ नहीं करता। "
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "\"%1$@\" menyebut tombol \"%2$@\", yang tidak dikenali mesin, sehingga pintasan tidak melakukan apa pun. "
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "“%1$@” indica il tasto “%2$@”, che il motore non conosce, quindi la scorciatoia non fa nulla. "
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "「%1$@」で指定されたキー「%2$@」はエンジンが認識できないため、このショートカットは機能しません。 "
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "\"%1$@\"은(는) 엔진이 알지 못하는 키 \"%2$@\"을(를) 지정하므로 단축키가 작동하지 않습니다. "
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "‘%1$@’ noemt de toets ‘%2$@’, die de engine niet kent, dus de toetscombinatie doet niets. "
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "„%1$@” wskazuje klawisz „%2$@”, którego silnik nie zna, więc skrót nic nie robi. "
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "\"%1$@\" indica a tecla \"%2$@\", que o motor não conhece, então o atalho não faz nada. "
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "needs_review",
            "value": "\"%1$@\" indica a tecla \"%2$@\", que o motor não conhece, pelo que o atalho não faz nada. "
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "«%1$@» называет клавишу «%2$@», которую движок не знает, поэтому сочетание клавиш не работает. "
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "”%1$@” anger tangenten ”%2$@”, som motorn inte känner till, så kortkommandot gör ingenting. "
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "\"%1$@\" ระบุปุ่ม \"%2$@\" ซึ่งเอนจินไม่รู้จัก ปุ่มลัดจึงไม่ทำงาน "
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "“%1$@”, motorun tanımadığı “%2$@” tuşunu belirtiyor, bu yüzden kestirme hiçbir şey yapmaz. "
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "«%1$@» називає клавішу «%2$@», якої рушій не знає, тому скорочення не працює. "
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "\"%1$@\" chỉ định phím \"%2$@\" mà bộ máy không nhận biết, vì vậy phím tắt không có tác dụng. "
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "“%1$@”指定的按键“%2$@”无法被引擎识别，因此该快捷键不起作用。 "
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "「%1$@」指定的按鍵「%2$@」引擎無法辨識，因此此快速鍵沒有作用。 "
          }
        }
      }
    },
