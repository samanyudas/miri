    "Checks which process macOS credits with Miri's Accessibility permission.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "يتحقق من العملية التي ينسب إليها macOS إذن تسهيلات الاستخدام الخاص بـ Miri."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Prüft, welchem Prozess macOS die Bedienungshilfen-Berechtigung von Miri zuschreibt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Comprueba a qué proceso atribuye macOS el permiso de accesibilidad de Miri."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vérifie à quel processus macOS attribue l’autorisation Accessibilité de Miri."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "जाँचता है कि macOS, Miri की ऐक्सेसिबिलिटी अनुमति किस प्रोसेस को देता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Memeriksa proses mana yang diberi izin Aksesibilitas Miri oleh macOS."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Controlla a quale processo macOS attribuisce il permesso Accessibilità di Miri."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "macOSがMiriのアクセシビリティの許可をどのプロセスに与えているかを確認します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "macOS가 Miri의 손쉬운 사용 권한을 어떤 프로세스에 부여하는지 확인합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Controleert aan welk proces macOS de toegankelijkheidstoestemming van Miri toeschrijft."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sprawdza, któremu procesowi macOS przypisuje uprawnienie „Dostępność” nadane Miri."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Verifica a qual processo o macOS atribui a permissão de Acessibilidade do Miri."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Verifica a que processo o macOS atribui a permissão de acessibilidade do Miri."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Проверяет, какому процессу macOS приписывает разрешение «Универсальный доступ», выданное Miri."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kontrollerar vilken process macOS tillskriver Miris hjälpmedelsbehörighet."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ตรวจสอบว่า macOS ให้สิทธิ์การช่วยการเข้าถึงของ Miri แก่กระบวนการใด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "macOS’in Miri’nin Erişilebilirlik iznini hangi işleme verdiğini denetler."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Перевіряє, якому процесу macOS приписує дозвіл «Доступність», наданий Miri."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kiểm tra xem macOS cấp quyền Trợ năng của Miri cho tiến trình nào."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "检查 macOS 将 Miri 的无障碍权限归属于哪个进程。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "檢查macOS將Miri的輔助使用權限歸屬於哪個程序。"
          }
        }
      }
    },
    "Choose three or four fingers below to use the swipe.": {
      "localizations": {
        "ar": {
