    "Restoring it returns it to the stack if there is room.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "تعود النافذة عند استعادتها إلى الرزمة إذا كان فيها متسع."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Beim Wiederherstellen kehrt es in den Stapel zurück, wenn Platz ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Al restaurarla, vuelve a la pila si hay sitio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La restaurer la remet dans sa pile s’il y a de la place."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "रीस्टोर करने पर, जगह होने पर यह स्टैक में लौट जाती है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Memulihkannya akan mengembalikannya ke tumpukan jika masih ada ruang."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Quando la ripristini, torna nella pila, se c’è spazio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "元に戻すと、スタックに空きがあればスタックに戻ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "복원하면 공간이 있는 경우 스택으로 돌아갑니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bij herstellen gaat het terug naar de stapel als er ruimte is."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Po przywróceniu okno wraca do stosu, jeśli jest w nim miejsce."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ao restaurá-la, ela volta para a pilha se houver espaço."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ao restaurá-la, volta para a pilha se houver espaço."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "При восстановлении окно вернется в стопку, если там есть место."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "När det återställs återvänder det till stapeln om det finns plats."
