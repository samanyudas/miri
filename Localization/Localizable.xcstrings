    "If you stopped Miri before logging out, it stays stopped.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "إذا أوقفت Miri قبل تسجيل الخروج، فسيبقى متوقفًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Wenn du Miri vor dem Abmelden gestoppt hast, bleibt es gestoppt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Si detuviste Miri antes de cerrar sesión, sigue detenido."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Si vous avez arrêté Miri avant de vous déconnecter, il reste arrêté."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "अगर आपने लॉग आउट करने से पहले Miri को रोका था, तो वह रुका रहता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Jika Anda menghentikan Miri sebelum keluar, Miri tetap berhenti."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Se hai interrotto Miri prima di uscire dalla sessione, resta interrotto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ログアウト前にMiriを停止していた場合は、停止したままになります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "로그아웃하기 전에 Miri를 중지했다면 중지된 상태로 유지됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Als je Miri hebt gestopt voordat je afmeldde, blijft het gestopt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Jeśli zatrzymasz Miri przed wylogowaniem, po zalogowaniu pozostanie zatrzymane."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Se você parou o Miri antes de encerrar a sessão, ele continua parado."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Se parou o Miri antes de terminar a sessão, este continua parado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Если вы остановили Miri перед выходом из системы, она останется остановленной."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Om du stoppade Miri innan du loggade ut förblir det stoppat."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ถ้าคุณหยุด Miri ก่อนออกจากระบบ Miri จะยังคงหยุดอยู่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Oturumu kapatmadan önce Miri’yi durdurduysanız durmuş olarak kalır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Якщо ви зупинили Miri перед виходом із системи, вона залишиться зупиненою."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nếu bạn dừng Miri trước khi đăng xuất, Miri sẽ vẫn dừng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "如果你在退出登录前停止了 Miri，它会保持停止状态。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "如果你在登出前停止了Miri，它會保持停止。"
          }
        }
      }
    },
    "If you use it anyway, one of the two shortcuts may stop working.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "إذا استخدمته على أي حال، فقد يتوقف أحد الاختصارين عن العمل."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Wenn du ihn trotzdem verwendest, funktioniert einer der beiden Kurzbefehle eventuell nicht mehr."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Si lo usas de todos modos, uno de los dos atajos podría dejar de funcionar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Si vous l’utilisez quand même, l’un des deux raccourcis risque de ne plus fonctionner."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "अगर आप फिर भी इसका उपयोग करते हैं, तो दोनों में से एक शॉर्टकट काम करना बंद कर सकता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Jika Anda tetap menggunakannya, salah satu dari kedua pintasan mungkin berhenti bekerja."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Se la usi comunque, una delle due scorciatoie potrebbe smettere di funzionare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "それでも使用すると、2つのショートカットのどちらかが機能しなくなることがあります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "그래도 사용하면 두 단축키 중 하나가 작동하지 않을 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Als je hem toch gebruikt, werkt een van de twee toetscombinaties mogelijk niet meer."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Jeśli i tak go użyjesz, jeden z dwóch skrótów może przestać działać."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Se usá-lo mesmo assim, um dos dois atalhos pode parar de funcionar."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Se o utilizar mesmo assim, um dos dois atalhos pode deixar de funcionar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Если все же использовать его, одно из двух сочетаний клавиш может перестать работать."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Om du använder det ändå kan ett av de två kortkommandona sluta fungera."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ถ้าคุณยังคงใช้ ปุ่มลัดหนึ่งในสองปุ่มอาจหยุดทำงาน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Yine de kullanırsanız iki kestirmeden biri çalışmayabilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Якщо все одно використати його, одне з двох скорочень може перестати працювати."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nếu bạn vẫn dùng, một trong hai phím tắt có thể ngừng hoạt động."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "如果仍要使用，这两个快捷键中可能有一个会失效。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "如果仍要使用，這兩個快速鍵其中之一可能會失效。"
          }
        }
      }
    },
