          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Окна, открытые до запуска Miri, возвращаются на прежние места."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Fönster som var öppna innan Miri startade går tillbaka dit de var."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "หน้าต่างที่เปิดก่อน Miri เริ่มจะกลับไปยังตำแหน่งเดิม"
          }
        },
        "tr": {
