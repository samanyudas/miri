    "You confirmed on %@ that the strip follows your fingers.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "لقد أكدت في %@ أن الشريط يتبع أصابعك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Du hast am %@ bestätigt, dass der Streifen deinen Fingern folgt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Confirmaste el %@ que la tira sigue tus dedos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vous avez confirmé le %@ que la bande suit vos doigts."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "आपने %@ को पुष्टि की थी कि स्ट्रिप आपकी उँगलियों के साथ चलती है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Anda mengonfirmasi pada %@ bahwa lajur mengikuti jari Anda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hai confermato il %@ che la striscia segue le tue dita."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@に、ストリップが指の動きに沿って動くことを確認しました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@에 스트립이 손가락을 따라 움직인다고 확인했습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Je hebt op %@ bevestigd dat de strook je vingers volgt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Potwierdzono %@, że pas podąża za palcami."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Você confirmou em %@ que a faixa acompanha seus dedos."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Confirmou a %@ que a faixa acompanha os seus dedos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Вы подтвердили %@, что лента следует за пальцами."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Du bekräftade den %@ att remsan följer dina fingrar."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "คุณยืนยันเมื่อ %@ ว่าแถวเลื่อนตามนิ้วของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Şeridin parmaklarınızı izlediğini %@ tarihinde onayladınız."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ви підтвердили %@, що стрічка рухається за пальцями."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bạn đã xác nhận vào %@ rằng dải di chuyển theo ngón tay của bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "你已于 %@ 确认条带会跟随你的手指移动。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "你已於%@確認條帶會跟著你的手指移動。"
          }
        }
      }
    },
