    "Your windows stay where they are. Miri stays stopped until you start it.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "تبقى نوافذك في أماكنها. يبقى Miri متوقفًا حتى تبدأه."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Deine Fenster bleiben, wo sie sind. Miri bleibt gestoppt, bis du es startest."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tus ventanas se quedan donde están. Miri sigue detenido hasta que lo inicies."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vos fenêtres restent où elles sont. Miri reste arrêté jusqu’à ce que vous le démarriez."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "आपकी विंडो जहाँ हैं वहीं रहती हैं। जब तक आप Miri शुरू नहीं करते, वह रुका रहता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Jendela Anda tetap di tempatnya. Miri tetap berhenti sampai Anda memulainya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Le tue finestre restano dove sono. Miri resta interrotto finché non lo avvii."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ウインドウはそのままの位置に残ります。Miriは開始するまで停止したままです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "윈도우는 현재 위치에 그대로 있습니다. 시작할 때까지 Miri는 중지된 상태로 유지됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Je vensters blijven waar ze zijn. Miri blijft gestopt totdat je het start."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Twoje okna zostają na miejscu. Miri pozostaje zatrzymane, dopóki go nie uruchomisz."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Suas janelas ficam onde estão. O Miri fica parado até você iniciá-lo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "needs_review",
            "value": "As suas janelas ficam onde estão. O Miri fica parado até o iniciar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ваши окна остаются на местах. Miri остается остановленной, пока вы ее не запустите."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dina fönster stannar där de är. Miri förblir stoppat tills du startar det."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "หน้าต่างของคุณจะอยู่ที่เดิม Miri จะหยุดอยู่จนกว่าคุณจะเริ่ม"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pencereleriniz oldukları yerde kalır. Siz başlatana kadar Miri durmuş olarak kalır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ваші вікна залишаються на місцях. Miri залишається зупиненою, доки ви її не запустите."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cửa sổ của bạn giữ nguyên vị trí. Miri vẫn dừng cho đến khi bạn khởi động."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "你的窗口会留在原处。在你启动 Miri 之前，它会保持停止状态。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "你的視窗會留在原處。在你啟動Miri之前，它會保持停止。"
          }
        }
      }
    },
    "a shortcut in System Settings > Keyboard > Keyboard Shortcuts": {
      "localizations": {
