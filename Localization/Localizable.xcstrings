    "The focused column gets a step narrower around its center. The columns beside it slide and keep their widths.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "يضيق العمود المركّز عليه خطوة واحدة حول مركزه. تنزلق الأعمدة المجاورة له وتحتفظ بعروضها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Die fokussierte Spalte wird um ihre Mitte einen Schritt schmaler. Die Spalten daneben rücken nach und behalten ihre Breite."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La columna activa se estrecha un paso alrededor de su centro. Las columnas de al lado se deslizan y mantienen su ancho."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La colonne active rétrécit d’un cran autour de son centre. Les colonnes voisines glissent et gardent leur largeur."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "फ़ोकस किया गया कॉलम अपना केंद्र स्थिर रखते हुए एक स्टेप संकरा हो जाता है। उसके पास के कॉलम खिसकते हैं और अपनी चौड़ाई बनाए रखते हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kolom terfokus menyempit satu langkah di sekitar titik tengahnya. Kolom di sampingnya bergeser dan mempertahankan lebarnya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La colonna attiva si restringe di un passo attorno al suo centro. Le colonne accanto scorrono e mantengono la loro larghezza."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "フォーカスのある列が中心を基準に1段階狭くなります。隣の列はスライドし、幅は変わりません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "초점이 있는 열이 가운데를 기준으로 한 단계 좁아집니다. 양옆의 열은 너비를 유지한 채 따라 움직입니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "De gefocuste kolom wordt een stap smaller rond zijn midden. De kolommen ernaast schuiven mee en houden hun breedte."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aktywna kolumna zwęża się o jeden krok wokół swojego środka. Sąsiednie kolumny się przesuwają i zachowują swoje szerokości."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A coluna em foco fica um passo mais estreita em torno do seu centro. As colunas ao lado deslizam e mantêm suas larguras."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A coluna em foco fica um passo mais estreita em torno do seu centro. As colunas ao lado deslizam e mantêm as suas larguras."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Колонка в фокусе становится на шаг уже относительно своего центра. Соседние колонки сдвигаются и сохраняют ширину."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Den fokuserade kolumnen blir ett steg smalare runt sin mitt. Kolumnerna bredvid glider och behåller sina bredder."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "คอลัมน์ที่โฟกัสอยู่แคบลงหนึ่งขั้นรอบจุดกึ่งกลาง คอลัมน์ข้างๆ จะเลื่อนตามโดยคงความกว้างไว้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Odaktaki sütun, ortası yerinde kalarak bir adım daralır. Yanındaki sütunlar kayar ve genişliklerini korur."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Колонка у фокусі стає на крок вужчою відносно свого центру. Сусідні колонки зсуваються й зберігають ширину."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cột có tiêu điểm hẹp đi một bậc quanh tâm của nó. Các cột bên cạnh trượt theo và giữ nguyên độ rộng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "焦点列以其中心为基准变窄一级。旁边的列会滑动，宽度保持不变。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "焦點欄以其中心為基準變窄一級。旁邊的欄會滑動，寬度保持不變。"
          }
        }
      }
    },
