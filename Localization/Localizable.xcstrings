    "Windows open before Miri started go back to where they were.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "تعود النوافذ التي كانت مفتوحة قبل بدء Miri إلى أماكنها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Fenster, die vor dem Start von Miri offen waren, kehren an ihren Platz zurück."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Las ventanas abiertas antes de que se iniciara Miri vuelven a su sitio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Les fenêtres ouvertes avant le démarrage de Miri retrouvent leur place."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Miri शुरू होने से पहले खुली विंडो अपनी पुरानी जगह पर लौट जाती हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Jendela yang terbuka sebelum Miri dimulai kembali ke tempat semula."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Le finestre aperte prima dell’avvio di Miri tornano dov’erano."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Miriの起動前に開いていたウインドウは元の位置に戻ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Miri 시작 전에 열려 있던 윈도우는 원래 위치로 돌아갑니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vensters die open waren voordat Miri startte, gaan terug naar waar ze waren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Okna otwarte przed uruchomieniem Miri wracają na swoje miejsca."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "As janelas abertas antes de o Miri iniciar voltam para onde estavam."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "needs_review",
