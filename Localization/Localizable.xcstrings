            "value": "Anteile der Displaybreite, schmalste zuerst. %@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Fracciones del ancho de la pantalla, de la más estrecha a la más ancha. %@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Fractions de la largeur du moniteur, de la plus étroite à la plus large. %@"
