        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aktywna kolumna przyjmuje następną predefiniowaną szerokość wokół swojego środka. Sąsiednie kolumny się przesuwają i zachowują swoje szerokości."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A coluna em foco passa para a próxima largura predefinida em torno do seu centro. As colunas ao lado deslizam e mantêm suas larguras."
