    },
    "The focused column takes the next preset width around its center. The columns beside it slide and keep their widths.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "يأخذ العمود المركّز عليه العرض التالي من العروض المعدة مسبقًا حول مركزه. تنزلق الأعمدة المجاورة له وتحتفظ بعروضها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Die fokussierte Spalte nimmt um ihre Mitte die nächste Breitenvorgabe an. Die Spalten daneben rücken nach und behalten ihre Breite."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
