        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "초점이 있는 열이 가운데를 기준으로 다음 사전 설정 너비로 바뀝니다. 양옆의 열은 너비를 유지한 채 따라 움직입니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "De gefocuste kolom krijgt de volgende breedtevoorinstelling rond zijn midden. De kolommen ernaast schuiven mee en houden hun breedte."
          }
