    "The focused column moves to the display above, after its active column. Focus follows it.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ينتقل العمود المركّز عليه إلى شاشة العرض العليا، بعد العمود النشط فيها. يتبعه التركيز."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Die fokussierte Spalte wechselt auf das Display darüber, hinter dessen aktive Spalte. Der Fokus folgt ihr."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La columna activa pasa a la pantalla de arriba, después de la columna activa de esa pantalla. Sigue activa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La colonne active passe sur le moniteur du haut, après la colonne active de celui-ci. Elle reste active."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
