    "Focus moves to column %lld of the strip. The strip scrolls if that column is off the display.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ينتقل التركيز إلى العمود %lld في الشريط. يتم تمرير الشريط إذا كان هذا العمود خارج شاشة العرض."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Der Fokus wechselt zu Spalte %lld des Streifens. Der Streifen scrollt, wenn diese Spalte außerhalb des Displays liegt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Se activa la columna %lld de la tira. La tira se desplaza si esa columna está fuera de la pantalla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La colonne %lld de la bande devient active. La bande défile si cette colonne est hors du moniteur."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "फ़ोकस स्ट्रिप के कॉलम %lld पर जाता है। अगर वह कॉलम डिस्प्ले से बाहर है, तो स्ट्रिप स्क्रॉल होती है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Fokus berpindah ke kolom %lld di lajur. Lajur bergulir jika kolom tersebut berada di luar layar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Si attiva la colonna %lld della striscia. La striscia scorre se quella colonna è fuori dallo schermo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "フォーカスがストリップの%lld番目の列に移動します。その列がディスプレイの外にある場合は、ストリップがスクロールします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "초점이 스트립의 %lld번 열로 이동합니다. 해당 열이 디스플레이 밖에 있으면 스트립이 스크롤됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "De focus gaat naar kolom %lld van de strook. De strook scrolt als die kolom buiten het beeldscherm valt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aktywna staje się kolumna %lld pasa. Pas się przewija, jeśli ta kolumna jest poza wyświetlaczem."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O foco vai para a coluna %lld da faixa. A faixa rola se essa coluna estiver fora da tela."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O foco passa para a coluna %lld da faixa. A faixa desloca-se se essa coluna estiver fora do monitor."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Фокус переходит на колонку %lld ленты. Лента прокручивается, если эта колонка за пределами дисплея."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Fokus flyttas till kolumn %lld i remsan. Remsan rullar om kolumnen är utanför bildskärmen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "โฟกัสย้ายไปยังคอลัมน์ที่ %lld ของแถว แถวจะเลื่อนถ้าคอลัมน์นั้นอยู่นอกจอภาพ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Odak şeritteki %lld. sütuna geçer. Sütun ekranın dışındaysa şerit kayar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Фокус переходить на колонку %lld стрічки. Стрічка прокручується, якщо ця колонка за межами дисплея."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tiêu điểm chuyển tới cột %lld của dải. Dải sẽ cuộn nếu cột đó nằm ngoài màn hình."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "焦点移到条带的第 %lld 列。如果该列不在显示器上，条带会滚动。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "焦點移至條帶的第%lld欄。如果該欄不在顯示器上，條帶會捲動。"
          }
        }
      }
    },
    "Focus moves to the column on the left. The strip scrolls if that column is off the display.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ينتقل التركيز إلى العمود على اليسار. يتم تمرير الشريط إذا كان هذا العمود خارج شاشة العرض."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Der Fokus wechselt zur Spalte links. Der Streifen scrollt, wenn diese Spalte außerhalb des Displays liegt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Se activa la columna de la izquierda. La tira se desplaza si esa columna está fuera de la pantalla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La colonne de gauche devient active. La bande défile si cette colonne est hors du moniteur."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "फ़ोकस बाईं ओर के कॉलम पर जाता है। अगर वह कॉलम डिस्प्ले से बाहर है, तो स्ट्रिप स्क्रॉल होती है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Fokus berpindah ke kolom di sebelah kiri. Lajur bergulir jika kolom tersebut berada di luar layar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Si attiva la colonna a sinistra. La striscia scorre se quella colonna è fuori dallo schermo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "フォーカスが左の列に移動します。その列がディスプレイの外にある場合は、ストリップがスクロールします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "초점이 왼쪽 열로 이동합니다. 해당 열이 디스플레이 밖에 있으면 스트립이 스크롤됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "De focus gaat naar de kolom links. De strook scrolt als die kolom buiten het beeldscherm valt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aktywna staje się kolumna po lewej. Pas się przewija, jeśli ta kolumna jest poza wyświetlaczem."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O foco vai para a coluna à esquerda. A faixa rola se essa coluna estiver fora da tela."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O foco passa para a coluna à esquerda. A faixa desloca-se se essa coluna estiver fora do monitor."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Фокус переходит на колонку слева. Лента прокручивается, если эта колонка за пределами дисплея."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Fokus flyttas till kolumnen till vänster. Remsan rullar om kolumnen är utanför bildskärmen."
