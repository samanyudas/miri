    "### Engine log (redacted)": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "### سجل المحرك (بعد حذف البيانات الحساسة)"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "### Engine-Protokoll (bereinigt)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "### Registro del motor (con datos ocultos)"
          }
