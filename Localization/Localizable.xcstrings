    "Cannot add dotted key %@ to an existing value or table.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "لا يمكن إضافة المفتاح المنقط %@ إلى قيمة أو جدول موجود."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Der Schlüssel mit Punkten %@ kann nicht zu einem vorhandenen Wert oder einer vorhandenen Tabelle hinzugefügt werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "No se puede añadir la clave con puntos %@ a un valor o una tabla existentes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Impossible d’ajouter la clé à points %@ à une valeur ou à une table existante."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "डॉट वाली की %@ को मौजूदा मान या टेबल में नहीं जोड़ा जा सकता।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tidak dapat menambahkan kunci bertitik %@ ke nilai atau tabel yang sudah ada."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Impossibile aggiungere la chiave puntata %@ a un valore o a una tabella esistente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ドット付きキー%@を既存の値またはテーブルに追加できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "점으로 구분된 키 %@을(를) 기존 값 또는 테이블에 추가할 수 없습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kan sleutel met punten %@ niet toevoegen aan een bestaande waarde of tabel."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nie można dodać klucza z kropkami %@ do istniejącej wartości lub tabeli."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Não é possível adicionar a chave com pontos %@ a um valor ou tabela existente."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Não é possível adicionar a chave com pontos %@ a um valor ou tabela existente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Нельзя добавить ключ с точками %@ к существующему значению или таблице."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Det går inte att lägga till den punktade nyckeln %@ i ett befintligt värde eller en befintlig tabell."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ไม่สามารถเพิ่มคีย์แบบจุด %@ ลงในค่าหรือตารางที่มีอยู่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Noktalı anahtar %@, var olan bir değere veya tabloya eklenemez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Не можна додати ключ із крапками %@ до наявного значення чи таблиці."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Không thể thêm khóa có dấu chấm %@ vào một giá trị hoặc bảng đã có."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "无法将带点的键 %@ 添加到已有的值或表中。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "無法將含點的鍵%@加入現有的值或表格。"
