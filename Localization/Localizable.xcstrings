    "Press + to add a shortcut. Miri blocks keys another action uses, and warns about macOS clashes.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "اضغط على + لإضافة اختصار. يمنع Miri المفاتيح التي يستخدمها إجراء آخر، وينبّه إلى التعارضات مع macOS."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Drücke +, um einen Kurzbefehl hinzuzufügen. Miri blockiert Tasten, die eine andere Aktion verwendet, und warnt vor Konflikten mit macOS."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pulsa + para añadir un atajo. Miri bloquea las teclas que usa otra acción y avisa de los conflictos con macOS."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Appuyez sur + pour ajouter un raccourci. Miri bloque les touches qu’une autre action utilise et signale les conflits avec macOS."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "शॉर्टकट जोड़ने के लिए + दबाएँ। Miri उन की को ब्लॉक करता है जिनका उपयोग कोई दूसरा कार्य करता है, और macOS से टकराव पर चेतावनी देता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tekan + untuk menambahkan pintasan. Miri memblokir tombol yang digunakan tindakan lain, dan memperingatkan jika bentrok dengan macOS."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Premi + per aggiungere una scorciatoia. Miri blocca i tasti usati da un’altra azione e avvisa dei conflitti con macOS."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "+ を押してショートカットを追加します。Miriはほかの操作で使われているキーをブロックし、macOSと競合する場合は警告します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "단축키를 추가하려면 +를 누르십시오. Miri는 다른 동작이 사용하는 키를 차단하고 macOS와의 충돌을 경고합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Druk op + om een toetscombinatie toe te voegen. Miri blokkeert toetsen die een andere actie gebruikt en waarschuwt voor conflicten met macOS."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Naciśnij +, aby dodać skrót. Miri blokuje klawisze używane przez inną czynność i ostrzega przed konfliktami z macOS."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pressione + para adicionar um atalho. O Miri bloqueia teclas usadas por outra ação e avisa sobre conflitos com o macOS."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Prima + para adicionar um atalho. O Miri bloqueia teclas usadas por outra ação e avisa sobre conflitos com o macOS."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Нажмите +, чтобы добавить сочетание клавиш. Miri не дает назначить клавиши, занятые другим действием, и предупреждает о конфликтах с macOS."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tryck på + för att lägga till ett kortkommando. Miri blockerar tangenter som en annan åtgärd använder och varnar för krockar med macOS."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "กด + เพื่อเพิ่มปุ่มลัด Miri จะบล็อกปุ่มที่การทำงานอื่นใช้อยู่ และเตือนเมื่อขัดกับ macOS"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kestirme eklemek için + düğmesine basın. Miri başka bir eylemin kullandığı tuşları engeller ve macOS çakışmaları konusunda uyarır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Натисніть +, щоб додати скорочення. Miri не дає призначити клавіші, зайняті іншою дією, і попереджає про конфлікти з macOS."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nhấn + để thêm phím tắt. Miri chặn các phím mà tác vụ khác đang dùng và cảnh báo khi xung đột với macOS."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "按 + 添加快捷键。Miri 会阻止使用其他操作已占用的按键，并在与 macOS 冲突时发出警告。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "按 + 加入快速鍵。Miri會阻擋其他動作已使用的按鍵，並在與macOS衝突時發出警告。"
          }
        }
      }
    },
    "Press Return to apply. Fractions of the display width, narrowest first.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "اضغط على Return للتطبيق. كسور من عرض شاشة العرض، الأضيق أولًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Drücke den Zeilenschalter, um die Werte anzuwenden. Anteile der Displaybreite, schmalste zuerst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pulsa Retorno para aplicar. Fracciones del ancho de la pantalla, de la más estrecha a la más ancha."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Appuyez sur Retour pour appliquer. Fractions de la largeur du moniteur, de la plus étroite à la plus large."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "लागू करने के लिए Return दबाएँ। डिस्प्ले की चौड़ाई के भिन्न, सबसे संकरी पहले।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tekan Return untuk menerapkan. Pecahan lebar layar, dimulai dari yang tersempit."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Premi Invio per applicare. Frazioni della larghezza dello schermo, dalla più stretta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Returnキーを押すと適用されます。ディスプレイ幅に対する割合（狭い順）。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Return 키를 눌러 적용하십시오. 디스플레이 너비에 대한 비율이며, 좁은 것부터 입력합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Druk op Return om toe te passen. Delen van de beeldschermbreedte, smalste eerst."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Naciśnij Return, aby zastosować. Ułamki szerokości wyświetlacza, od najwęższej."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pressione Return para aplicar. Frações da largura da tela, da mais estreita à mais larga."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Prima Return para aplicar. Frações da largura do monitor, da mais estreita para a mais larga."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Нажмите Return, чтобы применить. Доли ширины дисплея, от самой узкой."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tryck på returtangenten för att verkställa. Andelar av bildskärmens bredd, smalast först."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "กด Return เพื่อใช้ สัดส่วนของความกว้างจอภาพ เรียงจากแคบที่สุด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Uygulamak için Return tuşuna basın. Ekran genişliğinin kesirleri, en dar olan önce."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Натисніть Return, щоб застосувати. Частки ширини дисплея, від найвужчої."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nhấn Return để áp dụng. Tỷ lệ của độ rộng màn hình, hẹp nhất trước."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "按下 Return 键以应用。显示器宽度的比例，从窄到宽。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "按下Return鍵以套用。顯示器寬度的比例，由窄到寬。"
          }
        }
      }
    },
