    "The strip moved both ways.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "تحرك الشريط في الاتجاهين."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Der Streifen hat sich in beide Richtungen bewegt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La tira se ha movido en ambos sentidos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La bande a bougé dans les deux sens."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "स्ट्रिप दोनों ओर चली।"
