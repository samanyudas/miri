    "Up to %lld fit on the main display at the minimum height of %lld points. A full stack sends the next window to a new column.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "تتسع شاشة العرض الرئيسية لعدد من النوافذ يصل إلى %1$lld بالحد الأدنى للارتفاع (%2$lld نقطة). ترسل الرزمة الممتلئة النافذة التالية إلى عمود جديد."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bis zu %1$lld passen bei der Mindesthöhe von %2$lld Punkten auf das Hauptdisplay. Ein voller Stapel schickt das nächste Fenster in eine neue Spalte."
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Up to %1$lld fit on the main display at the minimum height of %2$lld points. A full stack sends the next window to a new column."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Caben hasta %1$lld en la pantalla principal con la altura mínima de %2$lld puntos. Cuando una pila está llena, la siguiente ventana va a una columna nueva."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Jusqu’à %1$lld tiennent sur le moniteur principal à la hauteur minimale de %2$lld points. Quand la pile est pleine, la fenêtre suivante va dans une nouvelle colonne."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "कम से कम %2$lld पॉइंट की ऊँचाई पर मुख्य डिस्प्ले पर अधिकतम %1$lld विंडो आती हैं। भरा हुआ स्टैक अगली विंडो को नए कॉलम में भेजता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hingga %1$lld jendela muat di layar utama pada tinggi minimum %2$lld poin. Tumpukan yang penuh mengirim jendela berikutnya ke kolom baru."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Fino a %1$lld ne entrano nello schermo principale all’altezza minima di %2$lld punti. Quando una pila è piena, la finestra successiva va in una nuova colonna."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "最小の高さ%2$lldポイントで、メインディスプレイには最大%1$lld個まで収まります。スタックがいっぱいになると、次のウインドウは新しい列に配置されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "주 디스플레이에는 최소 높이 %2$lld포인트로 최대 %1$lld개가 들어갑니다. 스택이 가득 차면 다음 윈도우는 새 열로 이동합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tot %1$lld passen op het hoofdbeeldscherm bij de minimale hoogte van %2$lld punten. Een volle stapel stuurt het volgende venster naar een nieuwe kolom."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Maksymalna liczba okien na głównym wyświetlaczu przy minimalnej wysokości %2$lld pkt: %1$lld. Pełny stos wysyła następne okno do nowej kolumny."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cabem até %1$lld na tela principal com a altura mínima de %2$lld pontos. Uma pilha cheia envia a próxima janela para uma nova coluna."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cabem até %1$lld no monitor principal com a altura mínima de %2$lld pontos. Uma pilha cheia envia a janela seguinte para uma nova coluna."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Максимальное число окон на основном дисплее при минимальной высоте %2$lld пт: %1$lld. Когда стопка заполнена, следующее окно попадает в новую колонку."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Upp till %1$lld får plats på huvudbildskärmen vid minsta höjden %2$lld punkter. En full stapel skickar nästa fönster till en ny kolumn."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "จอภาพหลักใส่ได้สูงสุด %1$lld หน้าต่างที่ความสูงต่ำสุด %2$lld จุด เมื่อกองซ้อนเต็ม หน้าต่างถัดไปจะไปยังคอลัมน์ใหม่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "En düşük %2$lld nokta yükseklikle ana ekrana en çok %1$lld pencere sığar. Dolu bir yığın sonraki pencereyi yeni bir sütuna gönderir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Максимальна кількість вікон на основному дисплеї за мінімальної висоти %2$lld пт: %1$lld. Коли стос заповнено, наступне вікно потрапляє в нову колонку."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Màn hình chính chứa được tối đa %1$lld cửa sổ ở chiều cao tối thiểu %2$lld điểm. Khi chồng đầy, cửa sổ tiếp theo sẽ vào một cột mới."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "以最小高度 %2$lld 点计算，主显示器最多可容纳 %1$lld 个窗口。堆叠已满时，下一个窗口会进入新的列。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "以最小高度%2$lld點計算，主顯示器最多可容納%1$lld個視窗。堆疊已滿時，下一個視窗會進入新的欄。"
          }
        }
      }
    },
