    "Swipe left and right with four fingers on the trackpad.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "مرّر سريعًا لليسار ولليمين بأربعة أصابع على لوحة التعقب."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Streiche mit vier Fingern auf dem Trackpad nach links und rechts."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Desliza a izquierda y derecha con cuatro dedos en el trackpad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Balayez vers la gauche et la droite avec quatre doigts sur le trackpad."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ट्रैकपैड पर चार उँगलियों से बाएँ और दाएँ स्वाइप करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Gesek ke kiri dan kanan dengan empat jari di trackpad."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Scorri a sinistra e a destra con quattro dita sul trackpad."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "トラックパッドで4本の指を使って左右にスワイプしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "트랙패드에서 네 손가락으로 왼쪽과 오른쪽으로 쓸어넘기십시오."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Veeg met vier vingers naar links en rechts op het trackpad."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Przesuń czterema palcami w lewo i w prawo po gładziku."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Deslize para a esquerda e para a direita com quatro dedos no trackpad."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Deslize para a esquerda e para a direita com quatro dedos no trackpad."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Смахните четырьмя пальцами влево и вправо по трекпаду."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Svep åt vänster och höger med fyra fingrar på styrplattan."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ปัดซ้ายและขวาด้วยสี่นิ้วบนแทร็คแพด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "İzleme dörtgeninde dört parmakla sola ve sağa kaydırın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Змахніть чотирма пальцями ліворуч і праворуч по трекпеду."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vuốt sang trái và phải bằng bốn ngón tay trên bàn di chuột."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "用四根手指在触控板上左右轻扫。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "用四根手指在觸控式軌跡板上左右滑動。"
          }
        }
      }
    },
