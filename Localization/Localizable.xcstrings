        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "초점이 있는 윈도우가 왼쪽 열에 합류합니다. 원래 열의 나머지 윈도우는 그대로 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Het gefocuste venster voegt zich bij de kolom links ervan. De rest van de oude kolom blijft staan."
