    "When off, open Miri from its menu bar icon.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "عند الإيقاف، افتح Miri من أيقونته في شريط القوائم."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Wenn ausgeschaltet, öffne Miri über sein Symbol in der Menüleiste."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Si está desactivado, abre Miri desde su icono de la barra de menús."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Si cette option est désactivée, ouvrez Miri depuis son icône dans la barre des menus."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "बंद होने पर, Miri को उसके मेन्यू बार आइकॉन से खोलें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Saat mati, buka Miri dari ikonnya di bar menu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Se è disattivato, apri Miri dalla sua icona nella barra dei menu."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "オフのときは、メニューバーのアイコンからMiriを開きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "끄면 메뉴 막대 아이콘에서 Miri를 여십시오."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Als dit uit staat, open je Miri via het symbool in de menubalk."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Gdy ta opcja jest wyłączona, otwieraj Miri ikoną na pasku menu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Quando desativado, abra o Miri pelo ícone na barra de menus."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Quando desativado, abra o Miri a partir do ícone na barra de menus."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Если выключено, открывайте Miri значком в строке меню."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "När det är av öppnar du Miri från dess symbol i menyraden."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
