    "Miri backs up your configuration file first.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "يأخذ Miri نسخة احتياطية من ملف التكوين أولًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Miri sichert zuerst deine Konfigurationsdatei."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Miri hace antes una copia de seguridad de tu archivo de configuración."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Miri sauvegarde d’abord votre fichier de configuration."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Miri पहले आपकी कॉन्फ़िगरेशन फ़ाइल का बैकअप लेता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Miri mencadangkan file konfigurasi Anda terlebih dahulu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Miri prima esegue un backup del file di configurazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Miriは先に設定ファイルをバックアップします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Miri가 먼저 구성 파일을 백업합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Miri maakt eerst een reservekopie van je configuratiebestand."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Miri najpierw tworzy kopię zapasową pliku konfiguracji."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Antes, o Miri faz um backup do arquivo de configuração."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Antes, o Miri faz uma cópia de segurança do ficheiro de configuração."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Перед этим Miri создаст резервную копию файла конфигурации."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Miri säkerhetskopierar din konfigurationsfil först."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Miri จะสำรองไฟล์การกำหนดค่าของคุณก่อน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Miri önce yapılandırma dosyanızı yedekler."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Спершу Miri створить резервну копію файлу конфігурації."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Miri sẽ sao lưu tệp cấu hình của bạn trước."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Miri 会先备份你的配置文件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Miri會先備份你的設定檔。"
          }
        }
      }
    },
    "Miri can't read your macOS gesture settings, so the test is the only check.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "لا يستطيع Miri قراءة إعدادات إيماءات macOS لديك، لذا فالاختبار هو الفحص الوحيد."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Miri kann deine Gesteneinstellungen von macOS nicht lesen, daher ist der Test die einzige Prüfung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Miri no puede leer tus ajustes de gestos de macOS, así que la prueba es la única comprobación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Miri ne peut pas lire vos réglages de geste macOS : le test est donc la seule vérification."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Miri आपकी macOS जेस्चर सेटिंग नहीं पढ़ सकता, इसलिए टेस्ट ही एकमात्र जाँच है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Miri tidak dapat membaca pengaturan gerakan macOS Anda, jadi tes adalah satu-satunya pemeriksaan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Miri non può leggere le impostazioni dei gesti di macOS, quindi il test è l’unico controllo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "MiriはmacOSのジェスチャ設定を読み取れないため、テストでのみ確認できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Miri는 macOS 제스처 설정을 읽을 수 없으므로 테스트로만 확인할 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Miri kan je gebaarinstellingen van macOS niet lezen, dus de test is de enige controle."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Miri nie może odczytać ustawień gestów macOS, więc test jest jedynym sprawdzeniem."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O Miri não consegue ler seus ajustes de gestos do macOS, então o teste é a única verificação."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O Miri não consegue ler as suas definições de gestos do macOS, pelo que o teste é a única verificação."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Miri не может прочитать настройки жестов macOS, поэтому остается только проверка."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Miri kan inte läsa dina gestinställningar i macOS, så testet är den enda kontrollen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Miri อ่านการตั้งค่าคำสั่งนิ้วของ macOS ไม่ได้ การทดสอบจึงเป็นการตรวจสอบเดียว"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Miri, macOS hareket ayarlarınızı okuyamıyor, bu yüzden tek denetim bu test."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Miri не може прочитати параметри жестів macOS, тому лишається тільки перевірка."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Miri không thể đọc cài đặt cử chỉ của macOS nên kiểm tra là cách duy nhất."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Miri 无法读取你的 macOS 手势设置，因此只能通过测试来检查。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Miri無法讀取你的macOS手勢設定，因此只能透過測試來檢查。"
          }
        }
      }
    },
    "Miri cannot change %@ because the file defines it in a form Miri does not rewrite. Edit it by hand.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "لا يستطيع Miri تغيير %@ لأن الملف يعرّفه بصيغة لا يعيد Miri كتابتها. حرّره يدويًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Miri kann %@ nicht ändern, weil die Datei den Wert in einer Form definiert, die Miri nicht umschreibt. Bearbeite ihn von Hand."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Miri no puede cambiar %@ porque el archivo lo define de una forma que Miri no reescribe. Edítalo a mano."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Miri ne peut pas modifier %@, car le fichier le définit sous une forme que Miri ne réécrit pas. Modifiez-le à la main."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Miri %@ को नहीं बदल सकता, क्योंकि फ़ाइल इसे ऐसे रूप में परिभाषित करती है जिसे Miri दोबारा नहीं लिखता। इसे हाथ से संपादित करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Miri tidak dapat mengubah %@ karena file mendefinisikannya dalam bentuk yang tidak ditulis ulang oleh Miri. Edit secara manual."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Miri non può modificare %@ perché il file lo definisce in una forma che Miri non riscrive. Modificalo a mano."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ファイル内の%@はMiriが書き換えられない形式で定義されているため、変更できません。手動で編集してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "파일이 Miri가 다시 작성하지 않는 형식으로 %@을(를) 정의하고 있어 Miri가 변경할 수 없습니다. 직접 편집하십시오."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Miri kan %@ niet wijzigen omdat het bestand dit definieert in een vorm die Miri niet herschrijft. Wijzig het handmatig."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Miri nie może zmienić %@, ponieważ plik definiuje to w formie, której Miri nie przepisuje. Zmień to ręcznie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O Miri não pode alterar %@ porque o arquivo o define de uma forma que o Miri não reescreve. Edite-o manualmente."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O Miri não pode alterar %@ porque o ficheiro o define de uma forma que o Miri não reescreve. Edite-o manualmente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Miri не может изменить %@, потому что в файле это задано в форме, которую Miri не переписывает. Измените это вручную."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Miri kan inte ändra %@ eftersom filen definierar det i en form som Miri inte skriver om. Redigera det för hand."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Miri ไม่สามารถเปลี่ยน %@ เพราะไฟล์กำหนดค่านี้ในรูปแบบที่ Miri ไม่เขียนใหม่ ให้แก้ไขด้วยตนเอง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dosya %@ ayarını Miri’nin yeniden yazmadığı bir biçimde tanımladığı için Miri bu ayarı değiştiremiyor. Elle düzenleyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Miri не може змінити %@, бо у файлі це задано у формі, яку Miri не переписує. Змініть це вручну."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Miri không thể thay đổi %@ vì tệp định nghĩa mục này ở dạng mà Miri không ghi lại. Hãy sửa thủ công."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Miri 无法更改 %@，因为文件中定义它的形式是 Miri 无法改写的。请手动编辑。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Miri無法更改%@，因為檔案中定義它的形式是Miri無法改寫的。請手動編輯。"
          }
        }
      }
    },
