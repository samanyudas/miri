    "Four is recommended. Three fingers can clash with Three Finger Drag.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "يوصى بأربعة. قد تتعارض ثلاثة أصابع مع «السحب بثلاثة أصابع»."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vier wird empfohlen. Drei Finger können mit „Mit drei Fingern bewegen“ kollidieren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Se recomienda cuatro. Con tres dedos puede haber conflicto con “Arrastrar con 3 dedos”."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Quatre est recommandé. Trois doigts peuvent entrer en conflit avec « Faire glisser avec 3 doigts »."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "चार की सलाह दी जाती है। तीन उँगलियाँ “तीन उँगलियों से ड्रैग” से टकरा सकती हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Empat disarankan. Tiga jari dapat bentrok dengan Seret Tiga Jari."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Quattro è consigliato. Tre dita possono entrare in conflitto con “Trascina con tre dita”."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "4本指をおすすめします。3本指は「3本指のドラッグ」と競合することがあります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "네 손가락을 권장합니다. 세 손가락은 세 손가락으로 드래그하기와 충돌할 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vier wordt aanbevolen. Drie vingers kunnen botsen met ‘Slepen met drie vingers’."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zalecane są cztery. Trzy palce mogą kolidować z funkcją „Przeciąganie trzema palcami”."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Quatro é o recomendado. Três dedos podem entrar em conflito com Arrastar com Três Dedos."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Recomenda-se quatro. Três dedos podem entrar em conflito com Arrastar com três dedos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Рекомендуется четыре. Смахивание тремя пальцами может конфликтовать с функцией «Перетягивание тремя пальцами»."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Fyra rekommenderas. Tre fingrar kan krocka med Trefingersdragning."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "แนะนำให้ใช้สี่นิ้ว เพราะสามนิ้วอาจขัดกับลากด้วยสามนิ้ว"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dört önerilir. Üç parmak, Üç Parmakla Sürükleme ile çakışabilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Рекомендовано чотири. Змахування трьома пальцями може конфліктувати з функцією «Перетягування трьома пальцями»."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nên dùng bốn ngón. Ba ngón có thể xung đột với Kéo bằng ba ngón tay."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "建议使用四指。三指可能与“三指拖移”冲突。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "建議使用四指。三指可能與「三指拖移」衝突。"
          }
        }
      }
    },
