    "%@ Miri does not change the file until it is fixed.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ لن يغيّر Miri الملف حتى يتم إصلاحه."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ Miri ändert die Datei erst, wenn der Fehler behoben ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ Miri no modifica el archivo hasta que se corrija."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ Miri ne modifie pas le fichier tant qu’il n’est pas corrigé."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ जब तक यह ठीक नहीं होता, Miri फ़ाइल नहीं बदलता।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ Miri tidak mengubah file sampai masalah ini diperbaiki."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ Miri non modifica il file finché non viene corretto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ 修正されるまで、Miriはこのファイルを変更しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ 이 문제가 해결될 때까지 Miri는 파일을 변경하지 않습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ Miri wijzigt het bestand pas als dit is opgelost."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ Miri nie zmieni pliku, dopóki błąd nie zostanie poprawiony."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ O Miri não altera o arquivo até que ele seja corrigido."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ O Miri não altera o ficheiro até que seja corrigido."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ Miri не изменит файл, пока ошибка не будет исправлена."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ Miri ändrar inte filen förrän felet är åtgärdat."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ Miri จะไม่เปลี่ยนแปลงไฟล์จนกว่าจะแก้ไขปัญหานี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ Sorun düzeltilene kadar Miri dosyayı değiştirmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ Miri не змінить файл, доки помилку не буде виправлено."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ Miri không thay đổi tệp cho đến khi lỗi này được sửa."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ 在问题修复前，Miri 不会更改此文件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ 在問題修正前，Miri不會更改此檔案。"
          }
        }
      }
    },
    "%@ Using %@ removes it from %@.": {
      "localizations": {
