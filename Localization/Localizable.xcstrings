    "Miri checks your Mac for anything that blocks window management. It never changes your settings for you.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "يفحص Miri جهاز Mac بحثًا عن أي شيء يمنع إدارة النوافذ. ولا يغيّر إعداداتك نيابةً عنك أبدًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Miri prüft deinen Mac auf alles, was die Fensterverwaltung blockiert. Deine Einstellungen ändert Miri nie für dich."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Miri comprueba si hay algo en tu Mac que impida la gestión de ventanas. Nunca cambia tus ajustes por ti."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Miri recherche sur votre Mac tout ce qui bloque la gestion des fenêtres. Il ne modifie jamais vos réglages à votre place."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Miri आपके Mac पर ऐसी हर चीज़ की जाँच करता है जो विंडो प्रबंधन को रोकती है। वह आपकी सेटिंग कभी अपने आप नहीं बदलता।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Miri memeriksa apa pun di Mac Anda yang menghalangi pengelolaan jendela. Miri tidak pernah mengubah pengaturan Anda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Miri controlla se sul Mac c’è qualcosa che blocca la gestione delle finestre. Non modifica mai le impostazioni al posto tuo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Miriは、ウインドウ管理を妨げるものがないかMacを確認します。設定を勝手に変更することはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Miri는 윈도우 관리를 막는 요소가 있는지 Mac을 확인합니다. 사용자 대신 설정을 변경하지는 않습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Miri controleert je Mac op alles wat vensterbeheer blokkeert. Miri wijzigt nooit zelf je instellingen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Miri sprawdza, czy coś na Macu nie blokuje zarządzania oknami. Nigdy nie zmienia ustawień za Ciebie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O Miri verifica se algo no seu Mac impede o gerenciamento de janelas. Ele nunca altera seus ajustes por você."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O Miri verifica se algo no seu Mac impede a gestão de janelas. Nunca altera as suas definições por si."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Miri проверяет, не мешает ли что-нибудь на Mac управлению окнами. Miri никогда не меняет настройки за вас."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Miri kontrollerar om något på din Mac blockerar fönsterhanteringen. Miri ändrar aldrig dina inställningar åt dig."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Miri ตรวจสอบ Mac ของคุณเพื่อหาสิ่งที่ขัดขวางการจัดการหน้าต่าง Miri จะไม่เปลี่ยนการตั้งค่าแทนคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Miri, Mac’inizde pencere yönetimini engelleyen bir şey olup olmadığını denetler. Ayarlarınızı sizin yerinize asla değiştirmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Miri перевіряє, чи ніщо на Mac не заважає керуванню вікнами. Miri ніколи не змінює параметри за вас."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Miri kiểm tra máy Mac của bạn để tìm những gì cản trở việc quản lý cửa sổ. Miri không bao giờ tự thay đổi cài đặt của bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Miri 会检查你的 Mac 上是否有任何会阻碍窗口管理的因素。它从不替你更改设置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Miri會檢查你的Mac上是否有任何會阻礙視窗管理的項目。它絕不會替你更改設定。"
          }
        }
      }
    },
