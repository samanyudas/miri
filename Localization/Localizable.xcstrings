    "Changes here apply right away. Settings from other tools are not touched.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "تُطبَّق التغييرات هنا فورًا. لا يتم المساس بإعدادات الأدوات الأخرى."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Änderungen hier gelten sofort. Einstellungen anderer Tools bleiben unberührt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Los cambios se aplican al instante. Los ajustes de otras herramientas no se tocan."
