            "state": "needs_review",
            "value": "फ़ोकस किए गए कॉलम की हर विंडो को एक जैसी ऊँचाई मिलती है। बाकी कॉलम जैसे हैं वैसे रहते हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Setiap jendela di kolom terfokus mendapat tinggi yang sama. Kolom lain tetap seperti semula."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tutte le finestre della colonna attiva prendono la stessa altezza. Le altre colonne restano come sono."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "フォーカスのある列のすべてのウインドウが同じ高さになります。ほかの列はそのままです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "초점이 있는 열의 모든 윈도우가 같은 높이가 됩니다. 다른 열은 그대로 유지됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Elk venster in de gefocuste kolom krijgt dezelfde hoogte. Andere kolommen blijven zoals ze zijn."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Każde okno w aktywnej kolumnie dostaje tę samą wysokość. Pozostałe kolumny się nie zmieniają."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Todas as janelas da coluna em foco ficam com a mesma altura. As outras colunas não mudam."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "needs_review",
