    "Movement is always instant when macOS Reduce Motion is on.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "تكون الحركة فورية دائمًا عند تشغيل «تقليل الحركة» في macOS."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bewegungen sind immer sofort, wenn „Bewegung reduzieren“ in macOS aktiviert ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "El movimiento siempre es instantáneo cuando “Reducir movimiento” de macOS está activado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Le déplacement est toujours instantané quand « Réduire les animations » est activé dans macOS."
