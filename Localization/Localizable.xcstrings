    "Quit %@ before starting Miri. Miri leaves %@'s configuration untouched.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "قم بإنهاء %1$@ قبل بدء Miri. لا يمس Miri تكوين %2$@."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Beende %1$@, bevor du Miri startest. Miri lässt die Konfiguration von %2$@ unverändert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Quit %1$@ before starting Miri. Miri leaves %2$@'s configuration untouched."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sal de %1$@ antes de iniciar Miri. Miri no toca la configuración de %2$@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Quittez %1$@ avant de démarrer Miri. Miri ne touche pas à la configuration de %2$@."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Miri शुरू करने से पहले %1$@ को बंद करें। Miri, %2$@ के कॉन्फ़िगरेशन को नहीं छूता।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tutup %1$@ sebelum memulai Miri. Miri tidak mengubah konfigurasi %2$@."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Esci da %1$@ prima di avviare Miri. Miri non tocca la configurazione di %2$@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Miriを起動する前に%1$@を終了してください。Miriは%2$@の設定を変更しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Miri를 시작하기 전에 %1$@을(를) 종료하십시오. Miri는 %2$@의 구성을 변경하지 않습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Stop %1$@ voordat je Miri start. Miri laat de configuratie van %2$@ ongemoeid."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zakończ %1$@ przed uruchomieniem Miri. Miri nie zmienia konfiguracji %2$@."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Encerre %1$@ antes de iniciar o Miri. O Miri não mexe na configuração de %2$@."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Saia de %1$@ antes de iniciar o Miri. O Miri não mexe na configuração de %2$@."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Завершите %1$@ перед запуском Miri. Miri не трогает конфигурацию %2$@."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Avsluta %1$@ innan du startar Miri. Miri lämnar konfigurationen för %2$@ orörd."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ออกจาก %1$@ ก่อนเริ่ม Miri โดย Miri จะไม่แตะต้องการกำหนดค่าของ %2$@"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Miri’yi başlatmadan önce şu uygulamadan çıkın: %1$@. Miri, %2$@ uygulamasının yapılandırmasına dokunmaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Завершіть %1$@ перед запуском Miri. Miri не змінює конфігурацію %2$@."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Thoát %1$@ trước khi khởi động Miri. Miri không đụng tới cấu hình của %2$@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "请在启动 Miri 前退出 %1$@。Miri 不会改动 %2$@ 的配置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "請在啟動Miri前結束%1$@。Miri不會更動%2$@的設定。"
          }
        }
      }
    },
