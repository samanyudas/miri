    "Keep at least two windows on this display so the strip can move.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "أبقِ نافذتين على الأقل على شاشة العرض هذه حتى يتمكن الشريط من الحركة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Lass mindestens zwei Fenster auf diesem Display, damit sich der Streifen bewegen kann."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mantén al menos dos ventanas en esta pantalla para que la tira pueda moverse."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Gardez au moins deux fenêtres sur ce moniteur pour que la bande puisse bouger."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "स्ट्रिप हिल सके, इसके लिए इस डिस्प्ले पर कम से कम दो विंडो रखें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Biarkan setidaknya dua jendela di layar ini agar lajur dapat bergerak."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tieni almeno due finestre su questo schermo perché la striscia possa muoversi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ストリップが動けるように、このディスプレイにウインドウを2つ以上置いてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "스트립이 움직일 수 있도록 이 디스플레이에 윈도우를 두 개 이상 두십시오."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Houd minstens twee vensters op dit beeldscherm zodat de strook kan bewegen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zostaw na tym wyświetlaczu co najmniej dwa okna, aby pas mógł się przesuwać."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mantenha pelo menos duas janelas nesta tela para que a faixa possa se mover."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mantenha pelo menos duas janelas neste monitor para que a faixa se possa mover."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Оставьте на этом дисплее не меньше двух окон, чтобы лента могла двигаться."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ha minst två fönster på den här bildskärmen så att remsan kan röra sig."
          }
        },
        "th": {
          "stringUnit": {
