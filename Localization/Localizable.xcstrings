    "Focus moves to the first column of the strip. The strip scrolls if that column is off the display.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ينتقل التركيز إلى العمود الأول في الشريط. يتم تمرير الشريط إذا كان هذا العمود خارج شاشة العرض."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Der Fokus wechselt zur ersten Spalte des Streifens. Der Streifen scrollt, wenn diese Spalte außerhalb des Displays liegt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Se activa la primera columna de la tira. La tira se desplaza si esa columna está fuera de la pantalla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La première colonne de la bande devient active. La bande défile si cette colonne est hors du moniteur."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "फ़ोकस स्ट्रिप के पहले कॉलम पर जाता है। अगर वह कॉलम डिस्प्ले से बाहर है, तो स्ट्रिप स्क्रॉल होती है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Fokus berpindah ke kolom pertama di lajur. Lajur bergulir jika kolom tersebut berada di luar layar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Si attiva la prima colonna della striscia. La striscia scorre se quella colonna è fuori dallo schermo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "フォーカスがストリップの最初の列に移動します。その列がディスプレイの外にある場合は、ストリップがスクロールします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "초점이 스트립의 첫 번째 열로 이동합니다. 해당 열이 디스플레이 밖에 있으면 스트립이 스크롤됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "De focus gaat naar de eerste kolom van de strook. De strook scrolt als die kolom buiten het beeldscherm valt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aktywna staje się pierwsza kolumna pasa. Pas się przewija, jeśli ta kolumna jest poza wyświetlaczem."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O foco vai para a primeira coluna da faixa. A faixa rola se essa coluna estiver fora da tela."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O foco passa para a primeira coluna da faixa. A faixa desloca-se se essa coluna estiver fora do monitor."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Фокус переходит на первую колонку ленты. Лента прокручивается, если эта колонка за пределами дисплея."
