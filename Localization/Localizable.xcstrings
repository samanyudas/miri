            "state": "needs_review",
            "value": "ストリップが左右両方向に動きました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "스트립이 양방향으로 움직였습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "De strook bewoog beide kanten op."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pas przesunął się w obie strony."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A faixa se moveu nos dois sentidos."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A faixa moveu-se nos dois sentidos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Лента сдвинулась в обе стороны."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Remsan rörde sig åt båda hållen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "แถวเลื่อนทั้งสองทางแล้ว"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Şerit iki yöne de hareket etti."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Стрічка зсунулася в обидва боки."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dải đã di chuyển cả hai chiều."
          }
        },
        "zh-Hans": {
