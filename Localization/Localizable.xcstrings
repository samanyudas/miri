    "%@ cycles through them.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "استخدم %@ للتنقل بينها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ wechselt der Reihe nach zwischen ihnen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ pasa de un ancho a otro."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ passe d’une largeur à l’autre."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ दबाकर इनके बीच बारी-बारी से जाएँ।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ beralih di antaranya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ passa da una larghezza all’altra."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ で順に切り替わります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ 키로 순서대로 전환합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ doorloopt ze."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ przełącza je po kolei."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ alterna entre elas."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ alterna entre elas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ переключает их по очереди."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ växlar mellan dem."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ จะวนไปตามค่าเหล่านี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ ile aralarında sırayla geçilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ перемикає їх по черзі."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ chuyển vòng qua các độ rộng này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ 可依次循环切换。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ 可依序循環切換。"
