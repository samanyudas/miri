    "Recording a shortcut for %@. Press the keys, or Escape to cancel.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "جارٍ تسجيل اختصار لـ %@. اضغط على المفاتيح، أو على Esc للإلغاء."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kurzbefehl für %@ wird aufgenommen. Drücke die Tasten oder Esc zum Abbrechen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Grabando un atajo para %@. Pulsa las teclas, o Esc para cancelar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Enregistrement d’un raccourci pour %@. Appuyez sur les touches, ou sur Échap pour annuler."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ के लिए शॉर्टकट रिकॉर्ड हो रहा है। की दबाएँ, या रद्द करने के लिए Esc दबाएँ।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Merekam pintasan untuk “%@”. Tekan tombolnya, atau Escape untuk membatalkan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Registrazione di una scorciatoia per %@. Premi i tasti, oppure Esc per annullare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "「%@」のショートカットを記録しています。キーを押すか、Escキーでキャンセルします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@의 단축키 기록 중. 키를 누르거나 Esc 키를 눌러 취소하십시오."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Toetscombinatie opnemen voor %@. Druk op de toetsen, of op Esc om te annuleren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nagrywanie skrótu dla „%@”. Naciśnij klawisze lub Escape, aby anulować."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Gravando um atalho para “%@”. Pressione as teclas ou Esc para cancelar."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A gravar um atalho para “%@”. Prima as teclas ou Esc para cancelar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Запись сочетания клавиш для «%@». Нажмите клавиши или Escape для отмены."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Spelar in ett kortkommando för %@. Tryck på tangenterna eller på Esc för att avbryta."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "กำลังบันทึกปุ่มลัดสำหรับ %@ กดปุ่ม หรือกด Escape เพื่อยกเลิก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@ için kestirme kaydediliyor. Tuşlara basın veya vazgeçmek için Esc tuşuna basın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Записування скорочення для «%@». Натисніть клавіші або Escape, щоб скасувати."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Đang ghi phím tắt cho %@. Nhấn các phím, hoặc nhấn Escape để hủy."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "正在为“%@”录制快捷键。请按下按键，或按 Esc 键取消。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "正在為「%@」錄製快速鍵。請按下按鍵，或按Esc鍵取消。"
          }
        }
      }
    },
    "Reduce Motion is on in System Settings, so windows move instantly.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "«تقليل الحركة» قيد التشغيل في إعدادات النظام، لذا تتحرك النوافذ فورًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "„Bewegung reduzieren“ ist in den Systemeinstellungen aktiviert, daher bewegen sich Fenster sofort."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "“Reducir movimiento” está activado en Ajustes del Sistema, así que las ventanas se mueven al instante."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "« Réduire les animations » est activé dans Réglages Système : les fenêtres se déplacent donc instantanément."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "सिस्टम सेटिंग में “गति घटाएँ” चालू है, इसलिए विंडो तुरंत मूव होती हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kurangi gerakan menyala di Pengaturan Sistem, jadi jendela berpindah secara instan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "“Riduci movimento” è attivo in Impostazioni di Sistema, quindi le finestre si spostano all’istante."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "システム設定で「視差効果を減らす」がオンのため、ウインドウは瞬時に移動します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "시스템 설정에서 동작 줄이기가 켜져 있으므로 윈도우가 즉시 이동합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "‘Verminder beweging’ staat aan in Systeeminstellingen, dus vensters bewegen direct."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Opcja „Redukuj ruch” jest włączona w Ustawieniach systemowych, więc okna przesuwają się natychmiast."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Reduzir Movimento está ativado em Ajustes do Sistema, então as janelas se movem instantaneamente."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Reduzir movimento está ativado nas Definições do Sistema, pelo que as janelas se movem instantaneamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "В Системных настройках включено «Уменьшить движение», поэтому окна перемещаются мгновенно."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Minska rörelse är på i System­inställningar, så fönster flyttas direkt."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ลดการเคลื่อนไหวเปิดอยู่ในการตั้งค่าระบบ หน้าต่างจึงย้ายทันที"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sistem Ayarları’nda Hareketi azalt açık, bu yüzden pencereler anında hareket eder."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "У Системних параметрах увімкнено «Зменшити рух», тому вікна рухаються миттєво."
          }
        },
        "vi": {
