          }
        }
      }
    },
    "Turn off %@ in System Settings > Desktop & Dock > Windows. macOS tiling moves windows that Miri arranges, including windows you drag.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "أوقف %@ في إعدادات النظام > سطح المكتب وشريط الأيقونات > النوافذ. يحرّك التجانب في macOS النوافذ التي يرتبها Miri، بما فيها النوافذ التي تسحبها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Deaktiviere %@ unter „Systemeinstellungen > Schreibtisch & Dock > Fenster“. Die Fensteranordnung von macOS bewegt Fenster, die Miri anordnet, auch Fenster, die du ziehst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "En Ajustes del Sistema > Escritorio y Dock > Ventanas, desactiva: %@. El ajuste de ventanas de macOS mueve las ventanas que Miri organiza, incluidas las que arrastras."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dans Réglages Système > Bureau et Dock > Fenêtres, désactivez : %@. La mosaïque de macOS déplace les fenêtres que Miri organise, y compris celles que vous faites glisser."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "सिस्टम सेटिंग > डेस्कटॉप और Dock > विंडो में %@ बंद करें। macOS टाइलिंग उन विंडो को मूव करती है जिन्हें Miri व्यवस्थित करता है, जिनमें आपके द्वारा ड्रैग की गई विंडो भी शामिल हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Matikan %@ di Pengaturan Sistem > Desktop & Dock > Jendela. Pengotakan macOS memindahkan jendela yang diatur Miri, termasuk jendela yang Anda seret."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "In Impostazioni di Sistema > Scrivania e Dock > Finestre, disattiva: %@. La disposizione a mosaico di macOS sposta le finestre disposte da Miri, comprese quelle che trascini."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "「システム設定 > デスクトップとDock > ウインドウ」で%@をオフにしてください。macOSのタイル表示は、ドラッグしたウインドウを含め、Miriが配置したウインドウを動かします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "시스템 설정 > 데스크탑 및 Dock > 윈도우에서 %@을(를) 끄십시오. macOS 윈도우 배치 기능은 사용자가 드래그하는 윈도우를 포함하여 Miri가 정렬하는 윈도우를 이동합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Schakel %@ uit in Systeeminstellingen > Bureaublad en Dock > Vensters. Vensterplaatsing van macOS verplaatst vensters die Miri ordent, ook vensters die je sleept."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Wyłącz te opcje w sekcji Ustawienia systemowe > Biurko i Dock > Okna: %@. Dokowanie okien w macOS przesuwa okna, które układa Miri, także okna, które przeciągasz."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Desative %@ em Ajustes do Sistema > Mesa e Dock > Janelas. O mosaico do macOS move as janelas que o Miri organiza, inclusive as que você arrasta."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Desative %@ em Definições do Sistema > Secretária e Dock > Janelas. A disposição em mosaico do macOS move as janelas que o Miri organiza, incluindo as que arrasta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "В разделе «Системные настройки > Рабочий стол и Dock > Окна» выключите: %@. Размещение окон плитками в macOS перемещает окна, которые упорядочивает Miri, в том числе окна, которые вы перетягиваете."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Stäng av %@ i System­inställningar > Skrivbord och Dock > Fönster. Fönsterplacering i macOS flyttar fönster som Miri ordnar, även fönster som du drar."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ปิด %@ ในการตั้งค่าระบบ > เดสก์ท็อปและ Dock > หน้าต่าง การจัดเรียงของ macOS จะย้ายหน้าต่างที่ Miri จัดเรียงอยู่ รวมถึงหน้าต่างที่คุณลาก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sistem Ayarları > Masaüstü ve Dock > Pencereler’de şu ayarları kapatın: %@. macOS döşemesi, sürüklediğiniz pencereler de dahil olmak üzere Miri’nin düzenlediği pencereleri taşır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "У розділі «Системні параметри > Робочий стіл і Dock > Вікна» вимкніть: %@. Закріплення вікон у macOS пересуває вікна, які впорядковує Miri, зокрема вікна, які ви перетягуєте."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tắt %@ trong Cài đặt hệ thống > Màn hình nền & Dock > Cửa sổ. Tính năng ghép cửa sổ của macOS di chuyển các cửa sổ mà Miri sắp xếp, kể cả cửa sổ bạn kéo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "请在“系统设置 > 桌面与程序坞 > 窗口”中关闭 %@。macOS 平铺会移动 Miri 排列的窗口，包括你拖移的窗口。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "請在「系統設定 > 桌面與Dock > 視窗」中關閉%@。macOS並排會移動Miri排列的視窗，包括你拖移的視窗。"
          }
        }
      }
    },
    "Turn off Stage Manager in System Settings > Desktop & Dock. It rearranges windows.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "أوقف منظم الواجهة في إعدادات النظام > سطح المكتب وشريط الأيقونات. فهو يعيد ترتيب النوافذ."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Deaktiviere Stage Manager unter „Systemeinstellungen > Schreibtisch & Dock“. Stage Manager ordnet Fenster neu an."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Desactiva el Organizador visual en Ajustes del Sistema > Escritorio y Dock. Reorganiza las ventanas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Désactivez Stage Manager dans Réglages Système > Bureau et Dock. Il réorganise les fenêtres."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "सिस्टम सेटिंग > डेस्कटॉप और Dock में स्टेज मैनेजर बंद करें। यह विंडो को फिर से व्यवस्थित करता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Matikan Pengelola Sorotan di Pengaturan Sistem > Desktop & Dock. Fitur ini menata ulang jendela."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Disattiva Stage Manager in Impostazioni di Sistema > Scrivania e Dock. Ridispone le finestre."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "「システム設定 > デスクトップとDock」で「ステージマネージャ」をオフにしてください。ステージマネージャはウインドウを並べ替えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "시스템 설정 > 데스크탑 및 Dock에서 스테이지 매니저를 끄십시오. 스테이지 매니저는 윈도우를 재배치합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Schakel Stage Manager uit in Systeeminstellingen > Bureaublad en Dock. Stage Manager herschikt vensters."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Wyłącz Stage Manager w sekcji Ustawienia systemowe > Biurko i Dock. Przestawia on okna."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Desative o Organizador Visual em Ajustes do Sistema > Mesa e Dock. Ele reorganiza as janelas."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Desative o Stage Manager em Definições do Sistema > Secretária e Dock. Este reorganiza as janelas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Выключите Постановщик в разделе «Системные настройки > Рабочий стол и Dock». Он переставляет окна."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Stäng av Blickfång i System­inställningar > Skrivbord och Dock. Blickfång ordnar om fönster."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ปิดตัวจัดการให้อยู่ตรงกลางในการตั้งค่าระบบ > เดสก์ท็อปและ Dock เพราะจะจัดเรียงหน้าต่างใหม่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sistem Ayarları > Masaüstü ve Dock’ta Sahne Yöneticisi’ni kapatın. Sahne Yöneticisi pencereleri yeniden düzenler."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Вимкніть Постановник у розділі «Системні параметри > Робочий стіл і Dock». Він переставляє вікна."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tắt Quản lý màn hình trong Cài đặt hệ thống > Màn hình nền & Dock. Tính năng này sắp xếp lại cửa sổ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "请在“系统设置 > 桌面与程序坞”中关闭“台前调度”。它会重新排列窗口。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "請在「系統設定 > 桌面與Dock」中關閉「幕前調度」。它會重新排列視窗。"
          }
        }
      }
    },
    "Turn on Displays have separate Spaces in System Settings > Desktop & Dock > Mission Control, then log out and back in.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "شغّل «توجد للشاشات مساحات منفصلة» في إعدادات النظام > سطح المكتب وشريط الأيقونات > إدارة المهام، ثم سجّل الخروج وسجّل الدخول مرة أخرى."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aktiviere „Monitore verwenden verschiedene Spaces“ unter „Systemeinstellungen > Schreibtisch & Dock > Mission Control“, melde dich dann ab und wieder an."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Activa “Pantallas con Spaces separados” en Ajustes del Sistema > Escritorio y Dock > Mission Control y, después, cierra sesión y vuelve a iniciarla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Activez « Les écrans disposent de Spaces distincts » dans Réglages Système > Bureau et Dock > Mission Control, puis déconnectez-vous et reconnectez-vous."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "सिस्टम सेटिंग > डेस्कटॉप और Dock > Mission Control में “अलग-अलग डिस्प्ले में अलग-अलग Spaces होने चाहिए” चालू करें, फिर लॉग आउट करके दोबारा लॉग इन करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nyalakan “Tampilan memiliki Spaces terpisah” di Pengaturan Sistem > Desktop & Dock > Mission Control, lalu keluar dan masuk kembali."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Attiva “Gli schermi hanno spazi separati” in Impostazioni di Sistema > Scrivania e Dock > Mission Control, poi esci dalla sessione e accedi di nuovo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "「システム設定 > デスクトップとDock > Mission Control」で「ディスプレイごとに個別の操作スペース」をオンにしてから、ログアウトして再度ログインしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "시스템 설정 > 데스크탑 및 Dock > Mission Control에서 각각의 Spaces가 있는 디스플레이를 켠 다음 로그아웃했다가 다시 로그인하십시오."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Schakel ‘Beeldschermen hebben afzonderlijke spaces’ in via Systeeminstellingen > Bureaublad en Dock > Mission Control, en log daarna uit en weer in."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Włącz opcję „Osobne przestrzenie dla wyświetlaczy” w sekcji Ustawienia systemowe > Biurko i Dock > Mission Control, a potem wyloguj się i zaloguj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ative “As telas têm Spaces separados” em Ajustes do Sistema > Mesa e Dock > Mission Control, depois encerre a sessão e inicie-a novamente."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ative “Ecrãs têm Spaces diferentes” em Definições do Sistema > Secretária e Dock > Mission Control e, depois, termine a sessão e volte a iniciá-la."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Включите «Дисплеи с разными рабочими пространствами Spaces» в разделе «Системные настройки > Рабочий стол и Dock > Mission Control», затем выйдите из системы и войдите снова."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Slå på Bildskärmar har egna Spaces i System­inställningar > Skrivbord och Dock > Mission Control och logga sedan ut och in igen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "เปิด Space ของจอภาพแยกต่างหากในการตั้งค่าระบบ > เดสก์ท็อปและ Dock > Mission Control แล้วออกจากระบบและเข้าสู่ระบบใหม่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sistem Ayarları > Masaüstü ve Dock > Mission Control’de Ekranların ayrı Spaces alanları olsun ayarını açın, ardından oturumu kapatıp yeniden açın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Увімкніть «Окремі Spaces на дисплеях» у розділі «Системні параметри > Робочий стіл і Dock > Mission Control», потім вийдіть із системи й увійдіть знову."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bật Màn hình có các Spaces riêng biệt trong Cài đặt hệ thống > Màn hình nền & Dock > Mission Control, rồi đăng xuất và đăng nhập lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "请在“系统设置 > 桌面与程序坞 > 调度中心”中打开“显示器具有单独空间”，然后退出登录并重新登录。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "請在「系統設定 > 桌面與Dock > 指揮中心」中開啟「顯示器有單獨空間」，然後登出再重新登入。"
          }
        }
      }
    },
    "Turn on Miri in System Settings > Privacy & Security > %@. Miri needs this Accessibility permission to move windows.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "شغّل Miri في إعدادات النظام > الخصوصية والأمن > %@. يحتاج Miri إلى إذن تسهيلات الاستخدام هذا لنقل النوافذ."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aktiviere Miri unter „Systemeinstellungen > Datenschutz & Sicherheit > %@“. Miri benötigt diese Berechtigung für Bedienungshilfen, um Fenster zu bewegen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Activa Miri en Ajustes del Sistema > Privacidad y seguridad > %@. Miri necesita este permiso de accesibilidad para mover ventanas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Activez Miri dans Réglages Système > Confidentialité et sécurité > %@. Miri a besoin de cette autorisation d’accessibilité pour déplacer les fenêtres."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "सिस्टम सेटिंग > गोपनीयता और सुरक्षा > %@ में Miri को चालू करें। विंडो मूव करने के लिए Miri को यह ऐक्सेसिबिलिटी अनुमति चाहिए।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nyalakan Miri di Pengaturan Sistem > Privasi & Keamanan > %@. Miri memerlukan izin Aksesibilitas ini untuk memindahkan jendela."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Attiva Miri in Impostazioni di Sistema > Privacy e sicurezza > %@. Miri ha bisogno di questo permesso di accessibilità per spostare le finestre."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "「システム設定 > プライバシーとセキュリティ > %@」でMiriをオンにしてください。Miriがウインドウを動かすには、このアクセシビリティの許可が必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "시스템 설정 > 개인정보 보호 및 보안 > %@에서 Miri를 켜십시오. Miri가 윈도우를 이동하려면 이 손쉬운 사용 권한이 필요합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Schakel Miri in via Systeeminstellingen > Privacy en beveiliging > %@. Miri heeft deze toegankelijkheidstoestemming nodig om vensters te verplaatsen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Włącz Miri w sekcji Ustawienia systemowe > Prywatność i ochrona > %@. Miri potrzebuje tego uprawnienia „Dostępność”, aby przesuwać okna."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ative o Miri em Ajustes do Sistema > Privacidade e Segurança > %@. O Miri precisa dessa permissão de Acessibilidade para mover janelas."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ative o Miri em Definições do Sistema > Privacidade e segurança > %@. O Miri precisa desta permissão de acessibilidade para mover janelas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Включите Miri в разделе «Системные настройки > Конфиденциальность и безопасность > %@». Miri нужно это разрешение «Универсальный доступ», чтобы перемещать окна."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Slå på Miri i System­inställningar > Integritet och säkerhet > %@. Miri behöver den här hjälpmedelsbehörigheten för att flytta fönster."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "เปิด Miri ในการตั้งค่าระบบ > ความเป็นส่วนตัวและความปลอดภัย > %@ Miri ต้องใช้สิทธิ์การช่วยการเข้าถึงนี้เพื่อย้ายหน้าต่าง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sistem Ayarları > Gizlilik ve Güvenlik > %@ bölümünde Miri’yi açın. Miri’nin pencereleri taşıyabilmesi için bu Erişilebilirlik izni gerekir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Увімкніть Miri в розділі «Системні параметри > Приватність і безпека > %@». Miri потрібен цей дозвіл «Доступність», щоб пересувати вікна."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bật Miri trong Cài đặt hệ thống > Quyền riêng tư & Bảo mật > %@. Miri cần quyền Trợ năng này để di chuyển cửa sổ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "请在“系统设置 > 隐私与安全 > %@”中打开 Miri。Miri 需要此无障碍权限来移动窗口。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "請在「系統設定 > 隱私權與安全性 > %@」中開啟Miri。Miri需要此輔助使用權限才能移動視窗。"
          }
        }
      }
    },
