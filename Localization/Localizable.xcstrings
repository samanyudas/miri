    "The engine stopped unexpectedly. Your windows are back on screen, and Miri restarts it in a moment.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "توقف المحرك بشكل غير متوقع. عادت نوافذك إلى الشاشة، وسيعيد Miri تشغيله بعد لحظات."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Die Engine wurde unerwartet beendet. Deine Fenster sind wieder auf dem Bildschirm, und Miri startet sie gleich neu."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "El motor se ha detenido de forma inesperada. Tus ventanas vuelven a estar en pantalla y Miri lo reinicia en un momento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Le moteur s’est arrêté de façon inattendue. Vos fenêtres sont de retour à l’écran, et Miri le redémarre dans un instant."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "इंजन अचानक रुक गया। आपकी विंडो वापस स्क्रीन पर हैं, और Miri थोड़ी देर में इंजन रीस्टार्ट करेगा।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mesin berhenti secara tak terduga. Jendela Anda kembali ke layar, dan Miri akan memulai ulang mesin sebentar lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Il motore si è interrotto in modo imprevisto. Le tue finestre sono di nuovo sullo schermo e Miri lo riavvia tra un attimo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "エンジンが予期せず停止しました。ウインドウは画面上に戻りました。Miriはまもなくエンジンを再起動します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "엔진이 예기치 않게 중지되었습니다. 윈도우가 화면에 다시 표시되었으며, Miri가 곧 엔진을 재시작합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "De engine is onverwacht gestopt. Je vensters staan weer op het scherm, en Miri herstart hem zo."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Silnik nieoczekiwanie się zatrzymał. Twoje okna wróciły na ekran, a Miri za chwilę uruchomi go ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O motor parou inesperadamente. Suas janelas voltaram para a tela, e o Miri vai reiniciá-lo em instantes."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O motor parou inesperadamente. As suas janelas voltaram ao ecrã, e o Miri vai reiniciá-lo dentro de momentos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Движок неожиданно остановился. Ваши окна снова на экране, и Miri скоро перезапустит движок."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Motorn stoppades oväntat. Dina fönster är tillbaka på skärmen, och Miri startar om den om en stund."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "เอนจินหยุดทำงานโดยไม่คาดคิด หน้าต่างของคุณกลับมาบนหน้าจอแล้ว และ Miri จะเริ่มเอนจินใหม่ในอีกสักครู่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Motor beklenmedik şekilde durdu. Pencereleriniz yeniden ekranda ve Miri motoru birazdan yeniden başlatacak."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Рушій неочікувано зупинився. Ваші вікна знову на екрані, і Miri незабаром перезапустить рушій."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bộ máy đã dừng đột ngột. Cửa sổ của bạn đã trở lại màn hình, và Miri sẽ khởi động lại bộ máy trong giây lát."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "引擎意外停止。你的窗口已回到屏幕上，Miri 稍后会重新启动它。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "引擎意外停止。你的視窗已回到螢幕上，Miri稍後會重新啟動它。"
          }
        }
      }
    },
    "The file changed while Miri was saving. Miri reloaded it. Try again.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "تغيّر الملف أثناء حفظ Miri له. أعاد Miri تحميله. حاول مرة أخرى."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Die Datei wurde geändert, während Miri sie gesichert hat. Miri hat sie neu geladen. Versuche es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "El archivo ha cambiado mientras Miri lo guardaba. Miri lo ha vuelto a cargar. Inténtalo de nuevo."
          }
