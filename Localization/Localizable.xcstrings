        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Miri के सहेजते समय फ़ाइल बदल गई। Miri ने इसे फिर से लोड किया। दोबारा कोशिश करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "File berubah saat Miri menyimpan. Miri telah memuat ulang file. Coba lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Il file è cambiato mentre Miri lo salvava. Miri lo ha ricaricato. Riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Miriの保存中にファイルが変更されました。Miriはファイルを再読み込みしました。もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Miri가 저장하는 동안 파일이 변경되었습니다. Miri가 파일을 다시 불러왔습니다. 다시 시도하십시오."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Het bestand is gewijzigd terwijl Miri het bewaarde. Miri heeft het opnieuw geladen. Probeer het nog eens."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Plik zmienił się, gdy Miri go zachowywało. Miri wczytało go ponownie. Spróbuj jeszcze raz."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O arquivo mudou enquanto o Miri salvava. O Miri o recarregou. Tente novamente."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O ficheiro mudou enquanto o Miri o guardava. O Miri recarregou-o. Tente novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Файл изменился, пока Miri его сохраняла. Miri загрузила его заново. Повторите попытку."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Filen ändrades medan Miri sparade. Miri läste in den igen. Försök igen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ไฟล์เปลี่ยนแปลงขณะที่ Miri กำลังบันทึก Miri โหลดไฟล์ใหม่แล้ว ลองอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Miri kaydederken dosya değişti. Miri dosyayı yeniden yükledi. Tekrar deneyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Файл змінився, поки Miri його зберігала. Miri завантажила його знову. Повторіть спробу."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tệp đã thay đổi trong khi Miri đang lưu. Miri đã tải lại tệp. Hãy thử lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Miri 保存时文件发生了更改。Miri 已重新载入文件。请再试一次。"
