    "Miri turns the strip swipe off until you test it again.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "يوقف Miri التمرير السريع للشريط حتى تختبره مرة أخرى."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
