    "Every window in the focused column gets the same height. Other columns stay as they are.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "تحصل كل نافذة في العمود المركّز عليه على الارتفاع نفسه. تبقى الأعمدة الأخرى كما هي."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Alle Fenster in der fokussierten Spalte erhalten dieselbe Höhe. Andere Spalten bleiben unverändert."
          }
        },
        "es": {
          "stringUnit": {
