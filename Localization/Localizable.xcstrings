        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "फ़ोकस की गई विंडो अपनी बाईं ओर के कॉलम में जुड़ जाती है। उसके पुराने कॉलम का बाकी हिस्सा अपनी जगह पर रहता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
