    "Three Finger Drag is on. Turn it off in System Settings > Accessibility > Pointer Control > Trackpad Options, or use four fingers.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "«السحب بثلاثة أصابع» قيد التشغيل. أوقفه في إعدادات النظام > تسهيلات الاستخدام > التحكم بالمؤشر > خيارات لوحة التعقب، أو استخدم أربعة أصابع."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "„Mit drei Fingern bewegen“ ist aktiviert. Deaktiviere die Option unter „Systemeinstellungen > Bedienungshilfen > Zeigersteuerung > Trackpad-Optionen“ oder verwende vier Finger."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "“Arrastrar con 3 dedos” está activado. Desactívalo en Ajustes del Sistema > Accesibilidad > Control del puntero > Opciones del trackpad, o usa cuatro dedos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "« Faire glisser avec 3 doigts » est activé. Désactivez-le dans Réglages Système > Accessibilité > Contrôle du pointeur > Options du trackpad, ou utilisez quatre doigts."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "“तीन उँगलियों से ड्रैग” चालू है। इसे सिस्टम सेटिंग > ऐक्सेसिबिलिटी > पॉइंटर कंट्रोल > ट्रैकपैड विकल्प में बंद करें, या चार उँगलियों का उपयोग करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Seret Tiga Jari menyala. Matikan di Pengaturan Sistem > Aksesibilitas > Kontrol Penunjuk > Pilihan Trackpad, atau gunakan empat jari."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "“Trascina con tre dita” è attivo. Disattivalo in Impostazioni di Sistema > Accessibilità > Controllo puntatore > Opzioni trackpad, oppure usa quattro dita."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "「3本指のドラッグ」がオンです。「システム設定 > アクセシビリティ > ポインタコントロール > トラックパッドオプション」でオフにするか、4本指を使ってください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "세 손가락으로 드래그하기가 켜져 있습니다. 시스템 설정 > 손쉬운 사용 > 포인터 제어 > 트랙패드 옵션에서 끄거나 네 손가락을 사용하십시오."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "‘Slepen met drie vingers’ staat aan. Schakel het uit in Systeeminstellingen > Toegankelijkheid > Aanwijzerbediening > Trackpadopties, of gebruik vier vingers."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Opcja „Przeciąganie trzema palcami” jest włączona. Wyłącz ją w sekcji Ustawienia systemowe > Dostępność > Sterowanie wskaźnikiem > Opcje gładzika lub używaj czterech palców."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Arrastar com Três Dedos está ativado. Desative essa opção em Ajustes do Sistema > Acessibilidade > Controle do Cursor > Opções do Trackpad ou use quatro dedos."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Arrastar com três dedos está ativado. Desative esta opção em Definições do Sistema > Acessibilidade > Controlo do cursor > Opções do trackpad ou use quatro dedos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "«Перетягивание тремя пальцами» включено. Выключите его в разделе «Системные настройки > Универсальный доступ > Управление указателем > Параметры трекпада» или используйте четыре пальца."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Trefingersdragning är på. Stäng av den i System­inställningar > Hjälpmedel > Pekarstyrning > Styrplattealternativ, eller använd fyra fingrar."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ลากด้วยสามนิ้วเปิดอยู่ ปิดได้ในการตั้งค่าระบบ > การช่วยการเข้าถึง > การควบคุมตัวชี้ > ตัวเลือกแทร็คแพด หรือใช้สี่นิ้ว"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Üç Parmakla Sürükleme açık. Bunu Sistem Ayarları > Erişilebilirlik > İmleç Denetimi > İzleme Dörtgeni Seçenekleri’nde kapatın veya dört parmak kullanın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "«Перетягування трьома пальцями» ввімкнено. Вимкніть його в розділі «Системні параметри > Доступність > Керування вказівником > Параметри трекпеда» або використовуйте чотири пальці."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kéo bằng ba ngón tay đang bật. Hãy tắt tùy chọn này trong Cài đặt hệ thống > Trợ năng > Điều khiển con trỏ > Tùy chọn Bàn di chuột, hoặc dùng bốn ngón."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "“三指拖移”已打开。请在“系统设置 > 无障碍 > 指针控制 > 触控板选项”中将其关闭，或使用四指。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "「三指拖移」已開啟。請在「系統設定 > 輔助使用 > 指標控制 > 觸控式軌跡板選項」中將其關閉，或使用四指。"
          }
        }
      }
    },
    "Three-finger strip swipe": {
      "localizations": {
        "ar": {
