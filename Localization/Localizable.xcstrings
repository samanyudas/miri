    "0.25, 0.5, 0.75": {
      "shouldTranslate": false
    },
    "A column waiting past an edge next to another display shows a photo of its window. Needs Screen Recording permission.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "يعرض العمود المنتظر خلف حافة مجاورة لشاشة عرض أخرى صورة لنافذته. يتطلب ذلك إذن تسجيل الشاشة وصوت النظام."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Eine Spalte, die hinter einem Rand neben einem anderen Display wartet, zeigt ein Foto ihres Fensters. Erfordert die Berechtigung „Aufnahme von Bildschirm & Systemaudio“."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Una columna que espera más allá de un borde junto a otra pantalla muestra una imagen de su ventana. Requiere el permiso “Grabación de pantalla y del audio del sistema”."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Une colonne en attente au-delà d’un bord voisin d’un autre moniteur affiche une capture de sa fenêtre. Nécessite l’autorisation « Enregistrement de l’écran et des sons du système »."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "किसी दूसरे डिस्प्ले के पास वाले किनारे के पार प्रतीक्षा कर रहा कॉलम अपनी विंडो की तस्वीर दिखाता है। इसके लिए स्क्रीन और सिस्टम ऑडियो रिकॉर्डिंग की अनुमति ज़रूरी है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kolom yang menunggu di luar tepi yang bersebelahan dengan layar lain menampilkan foto jendelanya. Memerlukan izin Rekaman Layar & Audio Sistem."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Una colonna in attesa oltre un bordo vicino a un altro schermo mostra un’istantanea della sua finestra. Richiede il permesso “Registrazione schermo e audio di sistema”."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "別のディスプレイと接する端の外で待機している列には、ウインドウのスナップショットが表示されます。「画面収録とシステムオーディオ録音」の許可が必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "다른 디스플레이와 맞닿은 가장자리 너머에서 대기 중인 열에는 해당 윈도우의 이미지가 표시됩니다. 화면 및 시스템 오디오 녹음 권한이 필요합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Een kolom die voorbij een rand naast een ander beeldscherm wacht, toont een foto van zijn venster. Vereist toestemming voor ‘Scherm- en systeemaudio-opname’."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kolumna czekająca za krawędzią obok innego wyświetlacza pokazuje zdjęcie swojego okna. Wymaga uprawnienia „Nagrywanie ekranu i dźwięku systemowego”."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Uma coluna que aguarda além de uma borda ao lado de outra tela mostra uma imagem da sua janela. Requer a permissão Gravação do Áudio do Sistema e da Tela."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Uma coluna que aguarda para lá de uma extremidade junto a outro monitor mostra uma imagem da sua janela. Requer a permissão Gravação do ecrã e de áudio do sistema."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Колонка, ожидающая за краем рядом с другим дисплеем, показывает снимок своего окна. Требуется разрешение «Запись экрана и системного звука»."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "En kolumn som väntar bortom en kant intill en annan bildskärm visar ett foto av sitt fönster. Kräver behörighet för Skärm- och systemljudsinspelning."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "คอลัมน์ที่รออยู่เลยขอบซึ่งติดกับจอภาพอื่นจะแสดงภาพของหน้าต่าง ต้องมีสิทธิ์การบันทึกหน้าจอและเสียงระบบ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Başka bir ekranın yanındaki kenarın ötesinde bekleyen sütun, penceresinin bir fotoğrafını gösterir. Ekran ve Sistem Sesi Kaydı izni gerekir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Колонка, що чекає за краєм поруч з іншим дисплеєм, показує знімок свого вікна. Потрібен дозвіл «Записування системного звуку й екрана»."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cột đang chờ ngoài cạnh tiếp giáp với màn hình khác sẽ hiển thị ảnh của cửa sổ đó. Cần quyền Bản ghi âm thanh hệ thống & màn hình."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "在与另一台显示器相邻的边缘外等待的列会显示其窗口的快照。需要“录屏与系统录音”权限。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "在與另一台顯示器相鄰的邊緣外等待的欄會顯示其視窗的快照。需要「螢幕與系統錄音」權限。"
          }
        }
      }
    },
