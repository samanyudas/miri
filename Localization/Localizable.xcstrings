    "%@ can move a window that Miri arranges, and the window's column can then change place in the strip. Quit %@ while Miri manages windows.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ can move a window that Miri arranges, and the window's column can then change place in the strip. Quit %2$@ while Miri manages windows."
          }
        }
      }
    },
    "%@ has a new default, %@, but %@ uses it.": {
      "localizations": {
